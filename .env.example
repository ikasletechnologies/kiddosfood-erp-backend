# Application
NODE_ENV=development
PORT=5000

# PostgreSQL
# Runtime connection URL (a pooled URL may be used in production).
DATABASE_URL=postgresql://postgres:password@localhost:5432/kiddosfood
# Direct database URL used by Prisma CLI and migrations.
DIRECT_URL=postgresql://postgres:password@localhost:5432/kiddosfood

# Authentication
# Generate long, independent random values for both secrets in every environment.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-token-secret

# Initial administrator created by the seed script
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# GST verification (Sandbox)
# Use a matching key/secret pair from https://dashboard.sandbox.co.in/.
SANDBOX_API_KEY=key_test_replace_me
SANDBOX_SECRET=secret_test_replace_me
# Optional override. Test keys use test-api automatically; live keys use api automatically.
# SANDBOX_API_BASE_URL=https://test-api.sandbox.co.in

# Optional legacy GSTVerify provider. Used only when Sandbox credentials are absent.
# GSTIN verification (https://www.gstinapi.in/docs)
GSTIN_API_BASE_URL=https://www.gstinapi.in
GSTIN_API_KEY=replace_me

# Business time zone offset from UTC, in minutes. India Standard Time is 330.
BUSINESS_TZ_OFFSET_MINUTES=330

# Safety switch for explicitly requested destructive development DB commands.
# Never enable this in production.
ALLOW_DESTRUCTIVE_DB_COMMAND=false

# Fynamics enhanced E-Way Bill API (server only). Production is blocked.
FYNAMICS_BASE_URL=https://staging.fynamics.co.in/api
FYNAMICS_CLIENT_ID=54QbR4VP0AzjgFi6
FYNAMICS_CLIENT_SECRET=bbdc0d21ac6eb3cd06acdc8128a3cde9
FYNAMICS_GSTIN=33BIEPA1248K1ZN
FYNAMICS_EWAY_USERNAME=ponraj
FYNAMICS_EWAY_PASSWORD=Ponraj@123

