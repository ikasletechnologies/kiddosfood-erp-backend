generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String
  franchiseId   String?
  branchId      String?
  is_active     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(FRANCHISE_ADMIN)
  activityLogs  ActivityLog[]
  employee      Employee?
  refreshTokens RefreshToken[]
  franchise     Franchise?     @relation(fields: [franchiseId], references: [id])
}

model WorkflowRequest {
  id            String            @id @default(uuid())
  displayId     String            @unique
  category      WorkflowCategory
  title         String
  amount        Float?
  currentStage  String
  initiatedBy   String
  franchiseId   String?
  dateInitiated DateTime          @default(now())
  details       Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  history       WorkflowHistory[]
  franchise     Franchise?        @relation(fields: [franchiseId], references: [id])
}

model WorkflowHistory {
  id         String          @id @default(uuid())
  requestId  String
  stage      String
  timestamp  DateTime        @default(now())
  userId     String?
  userLabel  String
  notes      String?
  isOverride Boolean         @default(false)
  request    WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Customer {
  id                 String            @id @default(uuid())
  name               String
  phone              String?           @unique
  email              String?           @unique
  loyaltyPoints      Float             @default(0)
  address            String?
  state              String?
  district           String?
  city               String?
  pincode            String?
  shippingAddress    String?
  gstNumber          String?
  gstType            String?
  openingBalance     Float             @default(0)
  openingBalanceType String?
  asOfDate           DateTime?
  creditLimit        Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  franchiseId        String?
  franchise          Franchise?        @relation(fields: [franchiseId], references: [id])
  ledgerEntries      CustomerLedger[]
  orders             Order[]
  productions        Production[]
  quotations         Quotation[]
  returnOrders       ReturnOrder[]
  salesOrders        SalesOrder[]
  deliveryChallans   DeliveryChallan[]
  proformaInvoices   ProformaInvoice[]

  @@index([franchiseId])
}

model Dealer {
  id               String            @id @default(uuid())
  name             String
  phone            String?           @unique
  email            String?           @unique
  address          String?
  status           String            @default("ACTIVE")
  franchiseId      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  franchise        Franchise         @relation(fields: [franchiseId], references: [id])
  deliveryChallans DeliveryChallan[]

  @@index([franchiseId])
}

model BusinessPartner {
  id          String      @id @default(uuid())
  name        String
  type        PartnerType
  phone       String?     @unique
  email       String?     @unique
  address     String?
  status      String      @default("ACTIVE")
  franchiseId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  franchise   Franchise   @relation(fields: [franchiseId], references: [id])
}

model CustomerLedger {
  id            String                @id @default(uuid())
  customerId    String
  type          LedgerType
  amount        Float
  paymentMode   PaymentMode
  referenceType CustomerLedgerRefType
  referenceId   String?
  accountId     String?
  note          String?
  createdAt     DateTime              @default(now())
  account       Account?              @relation(fields: [accountId], references: [id])
  customer      Customer              @relation(fields: [customerId], references: [id])
}

model Franchise {
  id                 String             @id @default(uuid())
  name               String
  location           String
  ownerName          String
  contactNum         String
  status             String             @default("ACTIVE")
  // Explicit source of truth for "is this franchise HQ" — replaces the
  // ~11 independent id==='hq-001'/name-contains-'HQ' heuristics that used
  // to be scattered across the codebase and could disagree with each other.
  // Exactly one franchise should have this set; FranchiseService.getHqFranchise()
  // enforces that invariant at read time.
  isHQ               Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dashboardPassword  String?
  creditLimit        Float              @default(0)
  outstandingAmount  Float              @default(0)
  walletBalance      Float              @default(0)
  activityLogs       ActivityLog[]
  businessPartners   BusinessPartner[]
  customers          Customer[]
  dealers            Dealer[]
  expenses           Expense[]
  ledgerEntries      FranchiseLedger[]
  franchiseOrders    FranchiseOrder[]
  franchiseRequests  FranchiseRequest[]
  inventory          InventoryItem[]
  orders             Order[]
  productBatches     ProductBatch[]
  productions        Production[]
  returnOrders       ReturnOrder[]
  stockRequests      StockRequest[]
  outgoingTransfers  StockTransfer[]    @relation("OutgoingTransfers")
  incomingTransfers  StockTransfer[]    @relation("IncomingTransfers")
  users              User[]
  workflowRequests   WorkflowRequest[]
  cheques            Cheque[]
  accounts           Account[]
  procurementOrders  ProcurementOrder[]
  loanAccounts       LoanAccount[]
  dailySettlements   DailySettlement[]
  wasteEntries       WasteEntry[]
  cartons            Carton[]
  primaryWarehouseId String?
  primaryWarehouse   Warehouse?         @relation("PrimaryWarehouse", fields: [primaryWarehouseId], references: [id])
}

model DailySettlement {
  id           String    @id @default(uuid())
  franchiseId  String
  businessDate DateTime
  cashTotal    Float     @default(0)
  upiTotal     Float     @default(0)
  cardTotal    Float     @default(0)
  grandTotal   Float     @default(0)
  orderCount   Int       @default(0)
  closedBy     String?
  createdAt    DateTime  @default(now())
  franchise    Franchise @relation(fields: [franchiseId], references: [id])

  @@unique([franchiseId, businessDate])
}

model Cheque {
  id           String       @id @default(uuid())
  chequeNumber String       @unique
  bankName     String
  payeeName    String
  entityBranch String?
  amount       Float
  type         ChequeType   @default(PAYABLE)
  issueDate    DateTime
  dueDate      DateTime
  status       ChequeStatus @default(PENDING)
  notes        String?
  franchiseId  String
  franchise    Franchise    @relation(fields: [franchiseId], references: [id])
  accountId    String?
  account      Account?     @relation(fields: [accountId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum ChequeType {
  PAYABLE
  RECEIVABLE
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

model InventoryItem {
  id                   String                 @id @default(uuid())
  name                 String
  sku                  String
  category             ItemCategory
  currentStock         Float
  unit                 String
  minimumStock         Float                  @default(10)
  batchNo              String?
  expiryDate           DateTime?
  franchiseId          String?
  vendorId             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  gstRate              Float                  @default(5)
  hsnCode              String?
  isActive             Boolean                @default(true)
  basePrice            Float?                 @default(0)
  costPrice            Float?                 @default(0)
  franchisePrice       Float?                 @default(0)
  dealerPrice          Float?                 @default(0)
  customerPrice        Float?                 @default(0)
  grnItems             GoodsReceiptItem[]
  inventoryBatches     InventoryBatch[]
  franchise            Franchise?             @relation(fields: [franchiseId], references: [id])
  vendor               Vendor?                @relation(fields: [vendorId], references: [id])
  poItems              ProcurementOrderItem[]
  productionItems      ProductionItem[]
  purchaseRequestItems PurchaseRequestItem[]
  recipeItems          RecipeItem[]
  movements            StockMovement[]
  requestItems         StockRequestItem[]
  transferItems        StockTransferItem[]
  vendors              VendorMaterial[]
  conversions          ItemUnitConversion[]
  baseUnitId           String?
  baseUnit             Unit?                  @relation(fields: [baseUnitId], references: [id])
  wasteEntries         WasteEntry[]

  // Scoped per franchise, not globally: the same master item (identical SKU)
  // legitimately has one row per location it's stocked at (HQ + each
  // branch/franchise) — see StockTransfer completion, which credits the
  // destination branch's row for this SKU rather than inventing a new one.
  @@unique([sku, franchiseId])
}

model WasteEntry {
  id                 String            @id @default(uuid())
  inventoryItemId    String
  franchiseId        String?
  warehouseId        String?
  quantity           Float
  reason             String
  note               String?
  costAtTime         Float?
  // Links a DAMAGED/SPOILED entry back to the packaging run that produced
  // it (Confirm Packaging) — null for wastage logged manually via the
  // standalone Wastage Control "Log Spoilage" flow.
  productPackagingId String?
  createdAt          DateTime          @default(now())
  inventoryItem      InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  franchise          Franchise?        @relation(fields: [franchiseId], references: [id])
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
  productPackaging   ProductPackaging? @relation(fields: [productPackagingId], references: [id])
}

model StockMovement {
  id            String            @id @default(uuid())
  itemId        String
  movementType  StockMovementType
  quantity       Float
  baseQty        Float?
  transactionUnit String?
  unitId         String?
  referenceType String?
  referenceId   String?
  note          String?
  createdBy     String?
  createdAt     DateTime          @default(now())
  binId         String?
  warehouseId   String?
  // The specific lot this transaction drew from (outbound) or created
  // (inbound), so the ledger can show a Batch ID per line instead of only
  // an item-level total. Null for movements with no traceable batch (e.g.
  // opening balances, or outbound quantity that spanned more than one lot).
  batchId       String?
  // Unit cost at the time of this transaction — the FIFO-consumed cost for
  // outbound movements, the receipt cost for inbound ones, or a fallback to
  // the item's moving-average costPrice. Stored on the movement itself so
  // the ledger doesn't need to re-derive historical cost on every read.
  unitCost      Float?
  bin           WarehouseBin?     @relation(fields: [binId], references: [id])
  item          InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse?        @relation(fields: [warehouseId], references: [id])
  unit          Unit?             @relation(fields: [unitId], references: [id])
  batch         InventoryBatch?   @relation(fields: [batchId], references: [id])

  @@index([movementType, createdAt])
}

model Vendor {
  id                     String             @id @default(uuid())
  name                   String
  contact                String
  email                  String?
  address                String?
  state                  String?
  district               String?
  city                   String?
  pincode                String?
  shippingAddress        String?
  gstType                String?
  openingBalance         Float              @default(0)
  asOfDate               DateTime?
  creditLimit            Float?
  remark                 String?
  manualPurchaseAdj      Float              @default(0)
  manualAdvanceAdj       Float              @default(0)
  rating                 Float?             @default(5.0)
  createdAt              DateTime           @default(now())
  category               String?
  gstNumber              String?
  paymentTerms           PaymentTerms       @default(IMMEDIATE)
  status                 VendorStatus       @default(ACTIVE)
  vendorCode             String?            @unique
  paymentReminderEnabled Boolean            @default(false)
  paymentReminderDays    Int                @default(1)
  items                  InventoryItem[]
  orders                 ProcurementOrder[]
  purchaseReturns        PurchaseReturn[]
  invoices               VendorInvoice[]
  ledgerEntries          VendorLedger[]
  suppliedMaterials      VendorMaterial[]
  vendorQuotations       VendorQuotation[]
}

model VendorLedger {
  id                      String                    @id @default(uuid())
  vendorId                String
  amount                  Float
  referenceType           VendorLedgerReferenceType
  referenceId             String?
  note                    String?
  createdAt               DateTime                  @default(now())
  paymentMode             PaymentMode
  accountId               String?
  type                    LedgerType
  balanceAfterTransaction Float                     @default(0)
  sourceModule            VendorLedgerSource        @default(MANUAL)
  invoiceId               String?
  account                 Account?                  @relation(fields: [accountId], references: [id])
  invoice                 VendorInvoice?            @relation(fields: [invoiceId], references: [id])
  vendor                  Vendor                    @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model VendorMaterial {
  vendorId    String
  materialId  String
  price       Float?
  lastUpdated DateTime      @default(now())
  quantity    Float?
  material    InventoryItem @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor      Vendor        @relation(fields: [vendorId], references: [id])

  @@id([vendorId, materialId])
}

model ProcurementOrder {
  id                   String                 @id @default(uuid())
  vendorId             String
  status               POStatus               @default(PENDING_APPROVAL)
  totalAmount          Float
  advancePaid          Float                  @default(0)
  // How much of `advancePaid` came from pre-existing vendor advance/credit
  // (as opposed to fresh cash paid at PO creation) — tracked separately so
  // it can be displayed ("₹100 Advance Applied") and so the same advance
  // can't be re-applied to another PO. Consumption is tracked here, not via
  // an extra offsetting VendorLedger entry, so the vendor's running ledger
  // balance isn't zeroed out before the purchase liability it's meant to
  // offset actually exists.
  advanceApplied       Float                  @default(0)
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  notes                String?
  items                Json?
  received             Boolean                @default(false)
  createdAt            DateTime               @default(now())
  balance              Float                  @default(0)
  cgst                 Float                  @default(0)
  igst                 Float                  @default(0)
  paid                 Float                  @default(0)
  sgst                 Float                  @default(0)
  subtotal             Float                  @default(0)
  poNumber             String?                @unique
  brokerageCost        Float                  @default(0)
  freightCost          Float                  @default(0)
  invoiceStatus        InvoiceStatus          @default(PENDING)
  paymentStatus        POPaymentStatus        @default(UNPAID)
  transportCost        Float                  @default(0)
  unloadingCost        Float                  @default(0)
  deliveryInstructions String?
  internalNotes        String?
  vendorNotes          String?
  paymentTerms         String?
  approvedAt           DateTime?
  approvedBy           String?
  warehouseId          String?
  franchiseId          String?
  purchaseType         PurchaseType           @default(RAW_MATERIAL)
  discountAmount       Float                  @default(0)
  expenses             Expense[]
  goodsReceipts        GoodsReceipt[]
  franchise            Franchise?             @relation(fields: [franchiseId], references: [id])
  vendor               Vendor                 @relation(fields: [vendorId], references: [id])
  warehouse            Warehouse?             @relation(fields: [warehouseId], references: [id])
  poItems              ProcurementOrderItem[]
  purchaseReturns      PurchaseReturn[]
  invoices             VendorInvoice[]

  @@index([franchiseId, createdAt])
  @@index([createdAt])
}

model ProcurementOrderItem {
  id               String           @id @default(uuid())
  poId             String
  inventoryItemId  String?
  quantity         Float
  price            Float
  unit             String           @default("UNIT")
  cgst             Float            @default(0)
  gstRate          Float            @default(5)
  hsnCode          String?
  igst             Float            @default(0)
  itemName         String?
  sgst             Float            @default(0)
  subtotal         Float            @default(0)
  total            Float            @default(0)
  inventoryItem    InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
}

model GoodsReceipt {
  id               String             @id @default(uuid())
  poId             String
  receivedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  receivedBy       String?
  status           GRNStatus          @default(PENDING)
  freightCost      Float              @default(0)
  unloadingCost    Float              @default(0)
  procurementOrder ProcurementOrder   @relation(fields: [poId], references: [id])
  items            GoodsReceiptItem[]
  invoices         VendorInvoice[]
}

model GoodsReceiptItem {
  id             String            @id @default(uuid())
  grnId          String
  materialId     String?
  quantity       Float
  receivedQty    Float
  acceptedQty    Float
  rejectedQty    Float
  price          Float
  unit           String            @default("UNIT")
  binId          String?
  expDate        DateTime?
  lotNumber      String?
  mfgDate        DateTime?
  qcStatus       QCStatus          @default(PENDING)
  vendorBatchNo  String?
  warehouseId    String?
  warehouseBinId String?
  grn            GoodsReceipt      @relation(fields: [grnId], references: [id])
  inventoryItem  InventoryItem?    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouseBin   WarehouseBin?     @relation(fields: [warehouseBinId], references: [id])
  warehouse      Warehouse?        @relation(fields: [warehouseId], references: [id])
  inspection     InspectionRecord?
}

model VendorInvoice {
  id               String           @id @default(uuid())
  vendorId         String
  poId             String
  grnId            String?
  invoiceNumber    String           @unique
  amount           Float
  status           InvoiceStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  billDate         DateTime?
  // Tax/commercial breakdown — `amount` was historically the only figure
  // stored (always gross-or-whatever-the-caller-sent, with no way to tell
  // which), which is how GST silently vanished when a bill was generated
  // without deriving these from the PO. `amount` remains the authoritative
  // GROSS invoice total; these are the breakdown behind it.
  subtotal         Float?
  taxAmount        Float?
  cgst             Float?
  sgst             Float?
  igst             Float?
  // How much of this invoice's gross amount has been settled via vendor
  // advance (as opposed to a cash/bank Payment) — kept separate so the
  // invoice's own gross `amount` never gets silently reduced by a
  // settlement (advance is a settlement method, not an invoice discount).
  advanceApplied   Float            @default(0)
  warehouseId      String?
  payments         Payment[]
  grn              GoodsReceipt?    @relation(fields: [grnId], references: [id])
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
  vendor           Vendor           @relation(fields: [vendorId], references: [id])
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id])
  ledgerEntries    VendorLedger[]
}

model Product {
  id              String               @id @default(uuid())
  name            String
  sku             String?              @unique
  description     String?
  basePrice       Float
  category        String?
  taxPercent      Float                @default(5)
  isActive        Boolean              @default(true)
  emoji           String?
  isVeg           Boolean              @default(true)
  is_menu_item    Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hsnCode         String?
  productType     ProductType          @default(FINISHED_GOOD)
  shelfLifeDays   Int?
  franchiseOrders FranchiseOrderItem[]
  orderItems      OrderItem[]
  batches         ProductBatch[]
  recipe          Recipe?
}

model Recipe {
  id                       String       @id @default(uuid())
  productId                String?      @unique
  recipeCode               String?      @unique
  category                 String?
  name                     String
  yieldQty                 Float        @default(1)
  yieldUnit                String       @default("KG")
  instructions             String?
  estimatedDurationMinutes Int?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  productions              Production[]
  product                  Product?     @relation(fields: [productId], references: [id])
  recipeItems              RecipeItem[]
}

model RecipeCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeItem {
  id               String        @id @default(uuid())
  recipeId         String
  inventoryItemId  String
  quantityRequired Float
  unit             String        @default("g")
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recipe           Recipe        @relation(fields: [recipeId], references: [id])
}

model Production {
  id             String               @id @default(uuid())
  // Canonical, business-facing identity. Generated once when the production
  // run is created and copied verbatim to ProductBatch on completion.
  productionBatchCode String?         @unique
  productionType String
  recipeId       String
  quantity       Float
  franchiseId    String
  status         ProductionStatus     @default(PENDING)
  producedBy     String?
  producedAt     DateTime             @default(now())
  customerId     String?
  endTime        DateTime?
  expiryDate     DateTime?
  startTime      DateTime?
  actualYield    Float?
  currentStage   ProductionStage      @default(QUEUED)
  stageUpdatedAt DateTime?
  operatorId     String?
  remarks        String?
  materialCost   Float?
  laborCost      Float?               @default(0)
  overheadCost   Float?               @default(0)
  totalCost      Float?
  // The actual scoping unit for stock: which warehouse this run drew its raw
  // materials from and validated availability against. franchiseId remains
  // required by the schema (other reports still key off it) but stock
  // validation no longer looks at it — see production.service.ts.
  warehouseId    String?
  operator       Employee?            @relation(fields: [operatorId], references: [id])
  batches        ProductBatch[]
  customer       Customer?            @relation(fields: [customerId], references: [id])
  franchise      Franchise            @relation(fields: [franchiseId], references: [id])
  recipe         Recipe               @relation(fields: [recipeId], references: [id])
  warehouse      Warehouse?           @relation(fields: [warehouseId], references: [id])
  items          ProductionItem[]
  stageLogs      ProductionStageLog[]

  @@index([franchiseId, status, producedAt])
}

model ProductionStageLog {
  id           String          @id @default(uuid())
  productionId String
  stage        ProductionStage
  enteredAt    DateTime        @default(now())
  production   Production      @relation(fields: [productionId], references: [id])
}

enum ProductionStage {
  QUEUED
  MIXING
  COOKING
  COOLING
  READY_FOR_QC
}

enum PackagingStatus {
  PENDING
  PARTIALLY_PACKED
  PACKAGED
}

model ProductBatch {
  id               String             @id @default(uuid())
  productId        String?
  productionId     String?             @unique
  quantity         Float
  expiryDate       DateTime?
  batchCode        String?
  createdAt        DateTime           @default(now())
  franchiseId      String?
  mfgDate          DateTime?          @default(now())
  qcStatus         String?            @default("PENDING") // PENDING, APPROVED, PARTIALLY_APPROVED, REJECTED, REWORK
  moistureCheck    Float?
  colorCheck       String?
  textureCheck     String?
  rejectionQty     Float?             @default(0)
  approvedQty      Float?             @default(0)
  qcRemarks        String?
  packagingStatus  PackagingStatus?   @default(PENDING)
  packagedQty      Float?             @default(0)
  cartonedQty      Float?             @default(0)
  unitCost         Float?
  totalCost        Float?
  franchise        Franchise?         @relation(fields: [franchiseId], references: [id])
  product          Product?           @relation(fields: [productId], references: [id])
  production       Production?        @relation(fields: [productionId], references: [id])
  packagings       ProductPackaging[]
  cartons          Carton[]
  inventoryBatches InventoryBatch[]
  recall           BatchRecall?

  @@index([franchiseId, expiryDate])
}

enum RecallStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecallStep {
  INITIATED
  DISTRIBUTION_LOCATED
  SALES_BLOCKED
  REPORT_GENERATED
  RETURN_COLLECTED
  COMPLETED
}

// One row per ProductBatch, ever — productBatchId is unique so the DB itself
// rejects a second concurrent "initiate" for the same batch (see
// recall.service.ts's create-then-fallback-to-update-if-CANCELLED pattern).
// This is the single source of truth for whether a batch is under recall and
// what step that recall has reached; the frontend must not derive this from
// its own timers.
model BatchRecall {
  id                String             @id @default(uuid())
  productBatchId    String             @unique
  status            RecallStatus       @default(IN_PROGRESS)
  step              RecallStep         @default(INITIATED)
  reason            String
  reasonNotes       String?
  // Real, computed figures — never hardcoded. distributedQty is populated by
  // locateDistribution() from actual InventoryBatch/StockMovement records;
  // returnedQty accumulates from collectReturn() and is bounded by it.
  distributedQty    Float              @default(0)
  returnedQty       Float              @default(0)
  affectedLocations Json?
  reportData        Json?
  initiatedBy       String?
  initiatedAt       DateTime           @default(now())
  completedAt       DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime           @updatedAt
  productBatch      ProductBatch       @relation(fields: [productBatchId], references: [id])
  events            BatchRecallEvent[]
}

// Persisted audit trail — the frontend's "Live Recall Audit Log" reads this,
// it does not generate its own messages.
model BatchRecallEvent {
  id          String      @id @default(uuid())
  recallId    String
  event       String
  status      String // SUCCESS, FAILED, INFO
  actor       String?
  affectedQty Float?
  details     Json?
  createdAt   DateTime    @default(now())
  recall      BatchRecall @relation(fields: [recallId], references: [id])
}

model Carton {
  id              String       @id @default(uuid())
  cartonCode      String       @unique
  batchId         String
  cartonSize      String
  unitsPerCarton  Int
  cartonCount     Int
  totalUnits      Int
  weightPerCarton Float?
  franchiseId     String?
  createdBy       String?
  createdAt       DateTime     @default(now())
  batch           ProductBatch @relation(fields: [batchId], references: [id])
  franchise       Franchise?   @relation(fields: [franchiseId], references: [id])
}

model ProductPackaging {
  id              String             @id @default(uuid())
  batchId         String
  packetSize      String // e.g. "100g", "500g", "1KG"
  quantityPackets Int
  totalWeight     Float // quantityPackets * size
  barcode         String             @unique
  printedLabels   Boolean            @default(false)
  // Two-phase packaging: a ticket starts as AWAITING_CONFIRMATION with no
  // inventory touched. Bulk deduction and Finished Goods creation only
  // happen at Confirm (see ProductionService.confirmPackaging). Historical
  // rows (created before this field existed, under the old one-shot flow)
  // default to CONFIRMED via the schema default itself — their Finished
  // Goods stock already exists, so they're retroactively "done". Every new
  // ticket passes status explicitly at creation, overriding this default.
  status          PackagingRunStatus @default(CONFIRMED)
  stickersPrinted Int?
  physicalChecked Boolean?
  goodQty         Int?
  damagedQty      Int?
  spoiledQty      Int?
  confirmedAt     DateTime?
  createdAt       DateTime           @default(now())
  batch           ProductBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  wasteEntries    WasteEntry[]
}

enum PackagingRunStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

model FranchiseOrder {
  id                   String                     @id @default(uuid())
  orderNumber          String                     @unique
  franchiseId          String
  status               FranchiseOrderStatus       @default(PENDING)
  orderType            FranchiseOrderType         @default(STOCK)
  fulfillmentPath      FranchiseOrderFulfillment?
  materialsReady       Boolean?
  materialsShortfall   Json?
  totalAmount          Float
  paymentType          PaymentType                @default(CREDIT)
  paymentStatus        String                     @default("UNPAID")
  notes                String?
  expectedDispatchDate DateTime?
  actualDispatchDate   DateTime?
  delayStatus          String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deliveryCharges      Float                      @default(0)
  priority             String                     @default("NORMAL")
  subtotal             Float                      @default(0)
  taxAmount            Float                      @default(0)
  franchise            Franchise                  @relation(fields: [franchiseId], references: [id])
  items                FranchiseOrderItem[]
  returnOrders         ReturnOrder[]

  @@index([franchiseId, createdAt])
  @@index([createdAt])
  @@index([franchiseId, status])
  @@index([status])
}

model FranchiseOrderItem {
  id          String         @id @default(uuid())
  orderId     String
  productId   String
  quantity    Float
  unitPrice   Float
  totalAmount Float
  productType ProductType    @default(FINISHED_GOOD)
  order       FranchiseOrder @relation(fields: [orderId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
}

model ProductionItem {
  id              String        @id @default(uuid())
  productionId    String
  inventoryItemId String
  usedQuantity    Float
  unitCost        Float?
  totalCost       Float?
  batchBreakdown  Json?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  production      Production    @relation(fields: [productionId], references: [id])
}

model StockRequest {
  id          String             @id @default(uuid())
  franchiseId String
  status      StockRequestStatus @default(PENDING)
  requestedBy String?
  requestedAt DateTime           @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  franchise   Franchise          @relation(fields: [franchiseId], references: [id])
  items       StockRequestItem[]
}

model StockRequestItem {
  id              String        @id @default(uuid())
  stockRequestId  String
  inventoryItemId String
  requestedQty    Float
  approvedQty     Float?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  stockRequest    StockRequest  @relation(fields: [stockRequestId], references: [id])
}

model StockTransfer {
  id           String              @id @default(uuid())
  fromBranchId String
  toBranchId   String
  status       StockTransferStatus @default(PENDING)
  initiatedBy  String?
  approvedBy   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  fromBranch   Franchise           @relation("OutgoingTransfers", fields: [fromBranchId], references: [id])
  toBranch     Franchise           @relation("IncomingTransfers", fields: [toBranchId], references: [id])
  items        StockTransferItem[]
}

model StockTransferItem {
  id              String        @id @default(uuid())
  transferId      String
  inventoryItemId String
  quantity        Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  transfer        StockTransfer @relation(fields: [transferId], references: [id])
}

model Order {
  id                 String        @id @default(uuid())
  invoiceNum         String        @unique
  customerId         String?
  branchId           String?
  franchiseId        String
  orderType          String        @default("DINE_IN")
  status             OrderStatus   @default(COMPLETED)
  subTotal           Float
  taxAmount          Float
  discountAmount     Float         @default(0)
  totalAmount        Float
  paymentStatus      String        @default("PAID")
  paymentType        String        @default("CASH")
  stateOfSupply      String?
  inventory_deducted Boolean       @default(false)
  sourceQuotationId  String?
  // Full chain traceability when this Tax Invoice was created via
  // Proforma → Convert (see SalesService.convertProformaToInvoice), not the
  // legacy direct Estimate → Tax Invoice path. Nullable: a standalone
  // invoice (created from /sales/invoices directly, or the legacy direct
  // Quotation convert) has neither.
  sourceProformaInvoiceId String?
  createdAt          DateTime      @default(now())
  delivery           Delivery?
  invoice            Invoice?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  franchise          Franchise     @relation(fields: [franchiseId], references: [id])
  orderItems         OrderItem[]
  payments           Payment[]
  returns            ReturnOrder[]

  // Dashboard/reporting hot paths: revenue-by-range (with and without a
  // franchise filter), pending-dispatch status lookups, and per-customer
  // outstanding-balance queries.
  @@index([franchiseId, createdAt])
  @@index([createdAt])
  @@index([franchiseId, status])
  @@index([customerId, paymentStatus])
  @@index([franchiseId, paymentStatus])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  quantity    Float
  unit        String  @default("NONE")
  price       Float
  discountPct Float   @default(0)
  taxAmount   Float?
  totalAmount Float?
  batchNumber String?
  unitCost    Float?
  totalCost   Float?
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                  String                @id @default(uuid())
  orderId             String?
  paymentMode         PaymentMode           @default(CASH)
  paidAmount          Float
  transactionRef      String?
  status              String                @default("SUCCESS")
  invoiceId           String?
  createdAt           DateTime              @default(now())
  accountId           String?
  entityId            String?
  entityType          String?
  type                AccountingPaymentType @default(INVOICE_LINKED)
  approvedBy          String?
  cancelledAt         DateTime?
  createdBy           String?
  isCancelled         Boolean               @default(false)
  linkedDocId         String?
  linkedDocType       LinkedDocType?
  paymentNumber       String?               @unique
  // Client-supplied key (one per logical "Make Payment" submission) so a
  // retry/double-click/API re-entry with the same key returns the existing
  // Payment instead of creating a second one. Nullable + unique: most
  // callers won't send one, but any that do get a real DB-level guarantee.
  idempotencyKey      String?               @unique
  reversalOfPaymentId String?
  sourceModule        PaymentSourceModule   @default(MANUAL)
  vendorInvoiceId     String?
  account             Account?              @relation(fields: [accountId], references: [id])
  invoice             Invoice?              @relation(fields: [invoiceId], references: [id])
  order               Order?                @relation(fields: [orderId], references: [id])
  vendorInvoice       VendorInvoice?        @relation(fields: [vendorInvoiceId], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
}

model Invoice {
  id                 String    @id @default(uuid())
  orderId            String    @unique
  totalAmount        Float
  taxAmount          Float
  finalAmount        Float
  roundOff           Float     @default(0)
  status             String    @default("PAID")
  termsAndConditions String?
  description        String?
  notes              String?
  createdAt          DateTime  @default(now())
  order              Order     @relation(fields: [orderId], references: [id])
  payments           Payment[]
}

model Account {
  id              String           @id @default(uuid())
  name            String
  type            AccountType
  balance         Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accountCode     String?          @unique
  status          String           @default("ACTIVE")
  franchiseId     String?
  franchise       Franchise?       @relation(fields: [franchiseId], references: [id])
  customerLedgers CustomerLedger[]
  expenses        Expense[]
  payments        Payment[]
  vendorLedgers   VendorLedger[]
  cheques         Cheque[]
}

model Expense {
  id              String            @id @default(uuid())
  franchiseId     String?
  category        String
  amount          Float
  date            DateTime          @default(now())
  description     String?
  purchaseOrderId String?
  accountId       String?
  paymentMode     PaymentMode?      @default(CASH)
  status          String            @default("UNPAID")
  attachmentUrl   String?
  cancelledAt     DateTime?
  expenseNumber   String?           @unique
  isCancelled     Boolean           @default(false)
  paidAmount      Float             @default(0)
  dueDate         DateTime?
  payee           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  account         Account?          @relation(fields: [accountId], references: [id])
  franchise       Franchise?        @relation(fields: [franchiseId], references: [id])
  purchaseOrder   ProcurementOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([franchiseId, date])
  @@index([date])
}

model Delivery {
  id            String   @id @default(uuid())
  orderId       String   @unique
  riderName     String?
  status        String   @default("PENDING")
  otp           String?
  customerPhone String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pipeline {
  id          String    @id @default(uuid())
  name        String
  description String?
  stages      String[]  @default(["Open", "Contacted", "Proposal Sent", "Deal Done", "Lost", "Not Serviceable"])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  crmForms    CRMForm[]
  leads       Lead[]
}

model Lead {
  id              String     @id @default(uuid())
  pipelineId      String
  contactName     String
  orgName         String?
  email           String?
  phone           String?
  designation     String?
  contactCountry  String?
  customerCountry String?
  customerCity    String?
  leadSource      String?
  budget          Float?
  subject         String?
  status          LeadStatus @default(NEW)
  assigneeId      String?
  creatorId       String?
  followUpDate    DateTime?
  closedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  pipeline        Pipeline   @relation(fields: [pipelineId], references: [id])
}

model CRMForm {
  id            String   @id @default(uuid())
  name          String
  pipelineId    String
  status        String   @default("ACTIVE")
  capturedLeads Int      @default(0)
  creatorId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pipeline      Pipeline @relation(fields: [pipelineId], references: [id])
}

model Employee {
  id                    String           @id @default(uuid())
  userId                String           @unique
  employeeCode          String           @unique
  department            String?
  designation           String?
  dateOfJoining         DateTime
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  bankAccount           String?
  ifscCode              String?
  panNumber             String?
  pfNumber              String?
  esiNumber             String?
  salaryStructureId     String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  aadhaarNumber         String?
  allowances            Decimal?         @default(0)
  altMobile             String?
  bankAccountHolder     String?
  bankBranch            String?
  bankName              String?
  bloodGroup            String?
  currentCity           String?
  currentPincode        String?
  currentState          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  employeeType          String?          @default("Permanent")
  hasAttendanceAccess   Boolean          @default(false)
  hasErpAccess          Boolean          @default(false)
  hasLeaveAccess        Boolean          @default(false)
  hasPayrollAccess      Boolean          @default(false)
  incentives            Decimal?         @default(0)
  isOvertimeEligible    Boolean          @default(false)
  maritalStatus         String?
  mobile                String?
  paymentMethod         String?          @default("Bank Transfer")
  permArea              String?
  permCity              String?
  permDistrict          String?
  permDoorNo            String?
  permPincode           String?
  permState             String?
  permStreet            String?
  personalEmail         String?
  reportingManager      String?
  salary                Decimal?
  salaryCreditDate      String?
  salaryType            String?          @default("Monthly")
  shiftTiming           String?
  upiId                 String?
  verificationStatus    String?          @default("PENDING")
  workLocation          String?
  salaryStructure       SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  user                  User             @relation(fields: [userId], references: [id])
  shifts                EmployeeShift[]
  leaves                Leave[]
  payslips              Payslip[]
  attendanceLogs        AttendanceLog[]
  leaveBalances         LeaveBalance[]
  productionsOperated   Production[]
}

model AttendanceLog {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime
  clockIn    DateTime?
  clockOut   DateTime?
  source     String?   @default("MANUAL")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model LeaveType {
  id       String         @id @default(uuid())
  name     String
  maxDays  Int
  isPaid   Boolean        @default(true)
  leaves   Leave[]
  balances LeaveBalance[]
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Int
  used        Int       @default(0)
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

model Leave {
  id          String      @id @default(uuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())
  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
}

model Shift {
  id        String          @id @default(uuid())
  name      String
  startTime String
  endTime   String
  employees EmployeeShift[]
}

model EmployeeShift {
  id         String   @id @default(uuid())
  employeeId String
  shiftId    String
  date       DateTime
  employee   Employee @relation(fields: [employeeId], references: [id])
  shift      Shift    @relation(fields: [shiftId], references: [id])
}

model SalaryComponent {
  id              String                @id @default(uuid())
  name            String
  type            ComponentType
  calculationType String                @default("FIXED")
  value           Float
  isActive        Boolean               @default(true)
  structureItems  SalaryStructureItem[]
}

model SalaryStructure {
  id          String                @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  employees   Employee[]
  items       SalaryStructureItem[]
}

model SalaryStructureItem {
  id            String          @id @default(uuid())
  structureId   String
  componentId   String
  overrideValue Float?
  component     SalaryComponent @relation(fields: [componentId], references: [id])
  structure     SalaryStructure @relation(fields: [structureId], references: [id])
}

model Payroll {
  id          String    @id @default(uuid())
  month       Int
  year        Int
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  payslips    Payslip[]
}

model Payslip {
  id              String    @id @default(uuid())
  payrollId       String?
  employeeId      String
  month           Int
  year            Int
  basicSalary     Float
  totalEarnings   Float
  totalDeductions Float
  netSalary       Float
  otHours         Float     @default(0)
  otAmount        Float     @default(0)
  components      Json
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  employee        Employee  @relation(fields: [employeeId], references: [id])
  payroll         Payroll?  @relation(fields: [payrollId], references: [id])
}

model Quotation {
  id               String          @id @default(uuid())
  quotationNumber  String          @unique
  // Generic party selection (Customer / Dealer / Franchise). customerId +
  // the `customer` relation below stay populated only when partyType is
  // CUSTOMER (preserves the existing relation/include); partyId is the
  // universal id regardless of type.
  partyType        PartyType       @default(CUSTOMER)
  partyId          String?
  customerId       String?
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  validUntil       DateTime?
  status           QuotationStatus @default(DRAFT)
  subTotal         Float
  taxAmount        Float
  discountAmount   Float           @default(0)
  totalAmount      Float
  termsConditions  String?
  notes            String?
  createdBy        String?
  convertedOrderId String?
  convertedInvoiceId String?
  trackingNumber   String?
  courierName      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customer         Customer?       @relation(fields: [customerId], references: [id])
  items            QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  productId   String?
  productName String
  quantity    Float
  unit        String?
  rate        Float
  taxPercent  Float     @default(0)
  taxAmount   Float     @default(0)
  totalAmount Float
  quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model SalesOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  quotationId     String?
  // One Proforma Invoice per Sales Order — the @unique is the DB-level
  // duplicate-prevention guard for "Create Proforma Invoice" (see
  // SalesService.convertSalesOrderToProforma), not just an app-level check.
  proformaInvoiceId String?        @unique
  // Copied forward from the source Estimate at conversion time — see
  // Quotation.partyType/partyId above for the same generic-party pattern.
  partyType       PartyType        @default(CUSTOMER)
  partyId         String?
  customerId      String?
  customerName    String?
  customerPhone   String?
  status          SalesOrderStatus @default(DRAFT)
  subTotal        Float
  taxAmount       Float
  discountAmount  Float            @default(0)
  totalAmount     Float
  deliveryDate    DateTime?
  deliveryAddress String?
  trackingNumber  String?
  courierName     String?
  notes           String?
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentStatus   String           @default("UNPAID")
  returns         ReturnOrder[]
  customer        Customer?        @relation(fields: [customerId], references: [id])
  items           SalesOrderItem[]
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  productId    String?
  productName  String
  quantity     Float
  unit         String?
  rate         Float
  taxPercent   Float      @default(0)
  taxAmount    Float      @default(0)
  totalAmount  Float
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

// A formal pre-invoice used for advance/payment requests or commercial
// confirmation — genuinely distinct from Quotation (which is just an
// estimate) even though the fields largely mirror it. Sits between
// SalesOrder and the Tax Invoice (Order+Invoice) in the document chain:
// Quotation -> SalesOrder -> ProformaInvoice -> Order/Invoice -> Payment.
model ProformaInvoice {
  id                 String                @id @default(uuid())
  proformaNumber     String                @unique
  sourceSalesOrderId String?               @unique
  customerId         String?
  customerName       String?
  customerPhone      String?
  status             ProformaInvoiceStatus @default(DRAFT)
  subTotal           Float
  taxAmount          Float
  discountAmount     Float                 @default(0)
  totalAmount        Float
  paymentTerms       String?
  notes              String?
  createdBy          String?
  // Duplicate-prevention for "Convert to Tax Invoice", same pattern as
  // SalesOrder.proformaInvoiceId above.
  convertedInvoiceId String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  customer           Customer?             @relation(fields: [customerId], references: [id])
  items              ProformaInvoiceItem[]
}

model ProformaInvoiceItem {
  id                String          @id @default(uuid())
  proformaInvoiceId String
  productId         String?
  productName       String
  quantity          Float
  unit              String?
  rate              Float
  taxPercent        Float           @default(0)
  taxAmount         Float           @default(0)
  totalAmount       Float
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id])
}

model ReturnOrder {
  id               String          @id @default(uuid())
  returnNumber     String          @unique
  salesOrderId     String?
  customerId       String?
  reason           String
  status           ReturnStatus    @default(PENDING)
  refundAmount     Float
  refundMethod     String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  franchiseId      String?
  franchiseOrderId String?
  posOrderId       String?
  items            ReturnItem[]
  customer         Customer?       @relation(fields: [customerId], references: [id])
  franchise        Franchise?      @relation(fields: [franchiseId], references: [id])
  franchiseOrder   FranchiseOrder? @relation(fields: [franchiseOrderId], references: [id])
  salesOrder       SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  posOrder         Order?          @relation(fields: [posOrderId], references: [id])

  @@index([franchiseId, createdAt])
  @@index([createdAt])
}

model ReturnItem {
  id          String      @id @default(uuid())
  returnId    String
  productId   String?
  productName String
  quantity    Float
  rate        Float
  totalAmount Float
  condition   String?
  return      ReturnOrder @relation(fields: [returnId], references: [id])
}

model DeliveryChallan {
  id                String                @id @default(uuid())
  challanNumber     String                @unique
  customerId        String?
  // External B2B reseller destination — architecturally distinct from
  // Customer (separate master, own scoping) even though stock accounting
  // treats it identically: dispatch deducts source stock, no destination
  // receipt (see SalesService.dispatchChallanStock/receiveChallanStock).
  dealerId          String?
  salesOrderId      String?
  franchiseId       String?
  sourceFranchiseId String?
  status            String                @default("DRAFT")
  challanDate       DateTime              @default(now())
  dueDate           DateTime?
  vehicleNo         String?
  driverName        String?
  stateOfSupply     String?
  notes             String?
  termsConditions   String?
  subTotal          Float                 @default(0)
  taxAmount         Float                 @default(0)
  totalAmount       Float                 @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  customer          Customer?             @relation(fields: [customerId], references: [id])
  dealer            Dealer?               @relation(fields: [dealerId], references: [id])
  items             DeliveryChallanItem[]
}

model DeliveryChallanItem {
  id          String          @id @default(uuid())
  challanId   String
  productId   String?
  productName String
  batchNumber String?
  quantity    Float
  unit        String          @default("NONE")
  rate        Float           @default(0)
  taxPercent  Float           @default(0)
  taxAmount   Float           @default(0)
  totalAmount Float           @default(0)
  challan     DeliveryChallan @relation(fields: [challanId], references: [id])
}

model PurchaseReturn {
  id                 String               @id @default(uuid())
  returnNumber       String               @unique
  procurementOrderId String?
  vendorId           String
  reason             String
  status             String               @default("PENDING")
  refundAmount       Float
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  procurementOrder   ProcurementOrder?    @relation(fields: [procurementOrderId], references: [id])
  vendor             Vendor               @relation(fields: [vendorId], references: [id])
  items              PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id          String         @id @default(uuid())
  returnId    String
  itemName    String
  quantity    Float
  unit        String
  rate        Float
  totalAmount Float
  return      PurchaseReturn @relation(fields: [returnId], references: [id])
}

model ActivityLog {
  id                String     @id @default(uuid())
  userId            String?
  targetFranchiseId String?
  action            String
  entityType        String?
  entityId          String?
  details           Json?
  createdAt         DateTime   @default(now())
  franchise         Franchise? @relation(fields: [targetFranchiseId], references: [id])
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model FranchiseRequest {
  id            String    @id @default(uuid())
  franchiseId   String
  requestType   String
  status        String    @default("PENDING")
  details       Json?
  adminResponse String?
  managedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  franchise     Franchise @relation(fields: [franchiseId], references: [id])
}

model FranchiseLedger {
  id            String                 @id @default(uuid())
  franchiseId   String
  type          LedgerType
  amount        Float
  balanceAfter  Float
  referenceType FranchiseLedgerRefType
  referenceId   String?
  note          String?
  createdAt     DateTime               @default(now())
  franchise     Franchise              @relation(fields: [franchiseId], references: [id])
}

model PurchaseRequest {
  id          String                @id @default(uuid())
  prNumber    String                @unique
  department  String?
  status      PRStatus              @default(DRAFT)
  requestedBy String?
  approvedBy  String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  items       PurchaseRequestItem[]
  rfqs        RequestForQuotation[]
}

model PurchaseRequestItem {
  id                String          @id @default(uuid())
  purchaseRequestId String
  inventoryItemId   String
  quantity          Float
  unit              String?
  notes             String?
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
}

model RequestForQuotation {
  id                String            @id @default(uuid())
  rfqNumber         String            @unique
  purchaseRequestId String?
  status            RFQMasterStatus   @default(OPEN)
  deadline          DateTime?
  notes             String?
  createdBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  purchaseRequest   PurchaseRequest?  @relation(fields: [purchaseRequestId], references: [id])
  quotations        VendorQuotation[]
}

model VendorQuotation {
  id          String                @id @default(uuid())
  rfqId       String
  vendorId    String
  status      QuotationReviewStatus @default(PENDING)
  totalAmount Float                 @default(0)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  rfq         RequestForQuotation   @relation(fields: [rfqId], references: [id])
  vendor      Vendor                @relation(fields: [vendorId], references: [id])
  items       VendorQuotationItem[]
}

model VendorQuotationItem {
  id                String          @id @default(uuid())
  vendorQuotationId String
  itemName          String
  quantity          Float
  unit              String
  quotedRate        Float?
  notes             String?
  vendorQuotation   VendorQuotation @relation(fields: [vendorQuotationId], references: [id])
}

model Warehouse {
  id                   String             @id @default(uuid())
  name                 String
  // Normalized form of `name` (lowercased, punctuation/whitespace stripped),
  // computed and maintained by the application. The @unique constraint is
  // the real guarantee against duplicate warehouses like "Home" vs "Home
  // (Hopes)" — an app-level pre-check alone can't close the race window
  // between two concurrent create requests; this can.
  nameKey              String             @unique
  code                 String?
  status               String             @default("ACTIVE")
  location             String?
  type                 String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  grnItems             GoodsReceiptItem[]
  movements            StockMovement[]
  bins                 WarehouseBin[]
  orders               ProcurementOrder[]
  primaryForFranchises Franchise[]        @relation("PrimaryWarehouse")
  inventoryBatches     InventoryBatch[]
  productions          Production[]
  vendorInvoices       VendorInvoice[]
  wasteEntries         WasteEntry[]
}

model WarehouseBin {
  id          String             @id @default(uuid())
  warehouseId String
  code        String
  description String?
  grnItems    GoodsReceiptItem[]
  movements   StockMovement[]
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
}

model InventoryBatch {
  id              String              @id @default(uuid())
  inventoryItemId String
  batchNumber     String
  lotNumber       String?
  mfgDate         DateTime?
  expDate         DateTime?
  initialQty      Float
  currentQty      Float
  unitCost        Float?
  productBatchId  String?
  // Which physical warehouse this lot was received into / belongs to. FIFO
  // consumption filters by this so production only draws from the warehouse
  // actually selected, not just "somewhere in the business." Nullable because
  // batches created before this existed have no warehouse on record.
  warehouseId     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  status          InventoryStockState @default(QC_HOLD)
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  productBatch    ProductBatch?       @relation(fields: [productBatchId], references: [id])
  warehouse       Warehouse?          @relation(fields: [warehouseId], references: [id])
  stockMovements  StockMovement[]
}

// Atomic counter for generating collision-free sequential numbers (e.g. GRN
// lot/batch numbers). A row-level UPDATE ... increment inside a transaction
// serializes concurrent callers at the DB level — unlike deriving a number
// from Date.now()/row counts, which two requests can race and both compute
// the same value from.
model NumberSequence {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id          String   @id @default(uuid())
  module      String
  action      String
  recordId    String?
  oldValue    Json?
  newValue    Json?
  performedBy String?
  ipAddress   String?
  timestamp   DateTime @default(now())
}

model InspectionRecord {
  id              String           @id @default(uuid())
  grnItemId       String           @unique
  inspectorId     String?
  inspectedAt     DateTime         @default(now())
  temperature     Float?
  moistureContent Float?
  packagingOk     Boolean          @default(true)
  totalQty        Float
  approvedQty     Float
  rejectedQty     Float
  scrapQty        Float            @default(0)
  actionTaken     QCAction         @default(HOLD)
  remarks         String?
  grnItem         GoodsReceiptItem @relation(fields: [grnItemId], references: [id])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  group       String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
}

