model InventoryReservation {
  id               String            @id @default(uuid())
  franchiseOrderId String            @unique
  status           ReservationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  releasedAt       DateTime?

  order       FranchiseOrder                   @relation(fields: [franchiseOrderId], references: [id])
  allocations InventoryReservationAllocation[]
}

model InventoryReservationAllocation {
  id               String @id @default(uuid())
  reservationId    String
  inventoryBatchId String
  inventoryItemId  String
  reservedQty      Float
  consumedQty      Float  @default(0)
  releasedQty      Float  @default(0)

  reservation    InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  inventoryBatch InventoryBatch       @relation(fields: [inventoryBatchId], references: [id])
  inventoryItem  InventoryItem        @relation(fields: [inventoryItemId], references: [id])

  @@index([reservationId])
  @@index([inventoryBatchId])
  @@index([inventoryItemId])
}

// Cache of GSTIN lookups so we only pay the GSTVerify per-call fee once per
// GSTIN; subsequent lookups (any user, any franchise) are served from here.
