  id               String   @id @default(uuid())
  gstin            String   @unique
  legalName        String?
  tradeName        String?
  status           String?
  constitution     String?
  taxpayerType     String?
  registrationDate String?
  pan              String?
  address          String?
  state            String?
  natureOfBusiness Json?
  raw              Json?
  fetchedAt        DateTime @default(now())
}
