generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String
  franchiseId   String?
  branchId      String?
  is_active     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(FRANCHISE_ADMIN)
  activityLogs  ActivityLog[]
  employee      Employee?
  refreshTokens RefreshToken[]
  franchise     Franchise?     @relation(fields: [franchiseId], references: [id])
}

model Customer {
  id                 String            @id @default(uuid())
  name               String
  phone              String?           @unique
  email              String?           @unique
  loyaltyPoints      Float             @default(0)
  address            String?
  state              String?
  district           String?
  city               String?
  pincode            String?
  shippingAddress    String?
  gstNumber          String?
  gstType            String?
  openingBalance     Float             @default(0)
  openingBalanceType String?
  asOfDate           DateTime?
  creditLimit        Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  franchiseId        String?
  franchise          Franchise?        @relation(fields: [franchiseId], references: [id])
  ledgerEntries      CustomerLedger[]
  orders             Order[]
  productions        Production[]
  quotations         Quotation[]
  returnOrders       ReturnOrder[]
  salesOrders        SalesOrder[]
  deliveryChallans   DeliveryChallan[]
}

model Dealer {
  id          String    @id @default(uuid())
  name        String
  phone       String?   @unique
  email       String?   @unique
  address     String?
  status      String    @default("ACTIVE")
  franchiseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
}

model BusinessPartner {
  id          String      @id @default(uuid())
  name        String
  type        PartnerType
  phone       String?     @unique
  email       String?     @unique
  address     String?
  status      String      @default("ACTIVE")
  franchiseId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  franchise   Franchise   @relation(fields: [franchiseId], references: [id])
}

model CustomerLedger {
  id            String                @id @default(uuid())
  customerId    String
  type          LedgerType
  amount        Float
  paymentMode   PaymentMode
  referenceType CustomerLedgerRefType
  referenceId   String?
  accountId     String?
  note          String?
  createdAt     DateTime              @default(now())
  account       Account?              @relation(fields: [accountId], references: [id])
  customer      Customer              @relation(fields: [customerId], references: [id])
}

model Franchise {
  id                String             @id @default(uuid())
  name              String
  location          String
  ownerName         String
  contactNum        String
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dashboardPassword String?
  creditLimit       Float              @default(0)
  outstandingAmount Float              @default(0)
  walletBalance     Float              @default(0)
  activityLogs      ActivityLog[]
  businessPartners  BusinessPartner[]
  customers         Customer[]
  dealers           Dealer[]
  expenses          Expense[]
  ledgerEntries     FranchiseLedger[]
  franchiseOrders   FranchiseOrder[]
  franchiseRequests FranchiseRequest[]
  inventory         InventoryItem[]
  orders            Order[]
  productBatches    ProductBatch[]
  productions       Production[]
  returnOrders      ReturnOrder[]
  stockRequests     StockRequest[]
  outgoingTransfers StockTransfer[]    @relation("OutgoingTransfers")
  incomingTransfers StockTransfer[]    @relation("IncomingTransfers")
  users             User[]
  cheques           Cheque[]
  accounts          Account[]
  procurementOrders ProcurementOrder[]
  loanAccounts      LoanAccount[]
  dailySettlements  DailySettlement[]
  wasteEntries      WasteEntry[]
  cartons           Carton[]
  primaryWarehouseId String?
  primaryWarehouse  Warehouse?         @relation("PrimaryWarehouse", fields: [primaryWarehouseId], references: [id])
}

model DailySettlement {
  id           String   @id @default(uuid())
  franchiseId  String
  businessDate DateTime
  cashTotal    Float    @default(0)
  upiTotal     Float    @default(0)
  cardTotal    Float    @default(0)
  grandTotal   Float    @default(0)
  orderCount   Int      @default(0)
  closedBy     String?
  createdAt    DateTime @default(now())
  franchise    Franchise @relation(fields: [franchiseId], references: [id])

  @@unique([franchiseId, businessDate])
}

model Cheque {
  id           String       @id @default(uuid())
  chequeNumber String       @unique
  bankName     String
  payeeName    String
  entityBranch String?
  amount       Float
  type         ChequeType   @default(PAYABLE)
  issueDate    DateTime
  dueDate      DateTime
  status       ChequeStatus @default(PENDING)
  notes        String?
  franchiseId  String
  franchise    Franchise    @relation(fields: [franchiseId], references: [id])
  accountId    String?
  account      Account?     @relation(fields: [accountId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum ChequeType {
  PAYABLE
  RECEIVABLE
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

model InventoryItem {
  id                   String                 @id @default(uuid())
  name                 String
  sku                  String
  category             ItemCategory
  currentStock         Float
  unit                 String
  minimumStock         Float                  @default(10)
  batchNo              String?
  expiryDate           DateTime?
  franchiseId          String?
  vendorId             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  gstRate              Float                  @default(5)
  hsnCode              String?
  isActive             Boolean                @default(true)
  basePrice            Float?                 @default(0)
  costPrice            Float?                 @default(0)
  franchisePrice       Float?                 @default(0)
  dealerPrice          Float?                 @default(0)
  customerPrice        Float?                 @default(0)
  grnItems             GoodsReceiptItem[]
  inventoryBatches     InventoryBatch[]
  franchise            Franchise?             @relation(fields: [franchiseId], references: [id])
  vendor               Vendor?                @relation(fields: [vendorId], references: [id])
  poItems              ProcurementOrderItem[]
  productionItems      ProductionItem[]
  purchaseRequestItems PurchaseRequestItem[]
  recipeItems          RecipeItem[]
  movements            StockMovement[]
  requestItems         StockRequestItem[]
  transferItems        StockTransferItem[]
  vendors              VendorMaterial[]
  conversions          ItemUnitConversion[]
  baseUnitId           String?
  baseUnit             Unit?                  @relation(fields: [baseUnitId], references: [id])
  wasteEntries         WasteEntry[]

  @@unique([sku])
}

model WasteEntry {
  id              String    @id @default(uuid())
  inventoryItemId String
  franchiseId     String?
  quantity        Float
  reason          String
  note            String?
  costAtTime      Float?
  createdAt       DateTime  @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  franchise       Franchise?    @relation(fields: [franchiseId], references: [id])
}

model StockMovement {
  id            String            @id @default(uuid())
  itemId        String
  movementType  StockMovementType
  quantity      Float
  baseQty       Float?
  unitId        String?
  referenceType String?
  referenceId   String?
  note          String?
  createdBy     String?
  createdAt     DateTime          @default(now())
  binId         String?
  warehouseId   String?
  bin           WarehouseBin?     @relation(fields: [binId], references: [id])
  item          InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse?        @relation(fields: [warehouseId], references: [id])
  unit          Unit?             @relation(fields: [unitId], references: [id])
}

model Vendor {
  id                String             @id @default(uuid())
  name              String
  contact           String
  email             String?
  address           String?
  state             String?
  district          String?
  city              String?
  pincode           String?
  shippingAddress   String?
  gstType           String?
  openingBalance    Float              @default(0)
  asOfDate          DateTime?
  creditLimit       Float?
  remark            String?
  manualPurchaseAdj Float              @default(0)
  manualAdvanceAdj  Float              @default(0)
  rating            Float?             @default(5.0)
  createdAt         DateTime           @default(now())
  category          String?
  gstNumber         String?
  paymentTerms      PaymentTerms       @default(IMMEDIATE)
  status            VendorStatus       @default(ACTIVE)
  vendorCode        String?            @unique
  items             InventoryItem[]
  orders            ProcurementOrder[]
  purchaseReturns   PurchaseReturn[]
  invoices          VendorInvoice[]
  ledgerEntries     VendorLedger[]
  suppliedMaterials VendorMaterial[]
  vendorQuotations  VendorQuotation[]
}

model VendorLedger {
  id                      String                    @id @default(uuid())
  vendorId                String
  amount                  Float
  referenceType           VendorLedgerReferenceType
  referenceId             String?
  note                    String?
  createdAt               DateTime                  @default(now())
  paymentMode             PaymentMode
  accountId               String?
  type                    LedgerType
  balanceAfterTransaction Float                     @default(0)
  sourceModule            VendorLedgerSource        @default(MANUAL)
  invoiceId               String?
  account                 Account?                  @relation(fields: [accountId], references: [id])
  invoice                 VendorInvoice?            @relation(fields: [invoiceId], references: [id])
  vendor                  Vendor                    @relation(fields: [vendorId], references: [id])
}

model VendorMaterial {
  vendorId    String
  materialId  String
  price       Float?
  lastUpdated DateTime      @default(now())
  quantity    Float?
  material    InventoryItem @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor      Vendor        @relation(fields: [vendorId], references: [id])

  @@id([vendorId, materialId])
}

model ProcurementOrder {
  id                   String                 @id @default(uuid())
  vendorId             String
  status               POStatus               @default(PENDING_APPROVAL)
  totalAmount          Float
  advancePaid          Float                  @default(0)
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  notes                String?
  items                Json?
  received             Boolean                @default(false)
  createdAt            DateTime               @default(now())
  balance              Float                  @default(0)
  cgst                 Float                  @default(0)
  igst                 Float                  @default(0)
  paid                 Float                  @default(0)
  sgst                 Float                  @default(0)
  subtotal             Float                  @default(0)
  poNumber             String?                @unique
  brokerageCost        Float                  @default(0)
  freightCost          Float                  @default(0)
  invoiceStatus        InvoiceStatus          @default(PENDING)
  paymentStatus        POPaymentStatus        @default(UNPAID)
  transportCost        Float                  @default(0)
  unloadingCost        Float                  @default(0)
  deliveryInstructions String?
  internalNotes        String?
  vendorNotes          String?
  approvedAt           DateTime?
  approvedBy           String?
  warehouseId          String?
  franchiseId          String?
  purchaseType         PurchaseType           @default(RAW_MATERIAL)
  discountAmount       Float                  @default(0)
  expenses             Expense[]
  goodsReceipts        GoodsReceipt[]
  franchise            Franchise?             @relation(fields: [franchiseId], references: [id])
  vendor               Vendor                 @relation(fields: [vendorId], references: [id])
  warehouse            Warehouse?             @relation(fields: [warehouseId], references: [id])
  poItems              ProcurementOrderItem[]
  purchaseReturns      PurchaseReturn[]
  invoices             VendorInvoice[]
}

model ProcurementOrderItem {
  id               String           @id @default(uuid())
  poId             String
  inventoryItemId  String?
  quantity         Float
  price            Float
  cgst             Float            @default(0)
  gstRate          Float            @default(5)
  hsnCode          String?
  igst             Float            @default(0)
  itemName         String?
  sgst             Float            @default(0)
  subtotal         Float            @default(0)
  total            Float            @default(0)
  inventoryItem    InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
}

model GoodsReceipt {
  id               String             @id @default(uuid())
  poId             String
  receivedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  receivedBy       String?
  status           GRNStatus          @default(PENDING)
  freightCost      Float              @default(0)
  unloadingCost    Float              @default(0)
  procurementOrder ProcurementOrder   @relation(fields: [poId], references: [id])
  items            GoodsReceiptItem[]
  invoices         VendorInvoice[]
}

model GoodsReceiptItem {
  id             String            @id @default(uuid())
  grnId          String
  materialId     String?
  quantity       Float
  receivedQty    Float
  acceptedQty    Float
  rejectedQty    Float
  price          Float
  binId          String?
  expDate        DateTime?
  lotNumber      String?
  mfgDate        DateTime?
  qcStatus       QCStatus          @default(PENDING)
  vendorBatchNo  String?
  warehouseId    String?
  warehouseBinId String?
  grn            GoodsReceipt      @relation(fields: [grnId], references: [id])
  inventoryItem  InventoryItem?    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouseBin   WarehouseBin?     @relation(fields: [warehouseBinId], references: [id])
  warehouse      Warehouse?        @relation(fields: [warehouseId], references: [id])
  inspection     InspectionRecord?
}

model VendorInvoice {
  id               String           @id @default(uuid())
  vendorId         String
  poId             String
  grnId            String?
  invoiceNumber    String           @unique
  amount           Float
  status           InvoiceStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  payments         Payment[]
  grn              GoodsReceipt?    @relation(fields: [grnId], references: [id])
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
  vendor           Vendor           @relation(fields: [vendorId], references: [id])
  ledgerEntries    VendorLedger[]
}

model Product {
  id              String               @id @default(uuid())
  name            String
  sku             String?              @unique
  description     String?
  basePrice       Float
  category        String?
  taxPercent      Float                @default(5)
  isActive        Boolean              @default(true)
  emoji           String?
  isVeg           Boolean              @default(true)
  is_menu_item    Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hsnCode         String?
  productType     ProductType          @default(FINISHED_GOOD)
  franchiseOrders FranchiseOrderItem[]
  orderItems      OrderItem[]
  batches         ProductBatch[]
  recipe          Recipe?
}

model Recipe {
  id           String       @id @default(uuid())
  productId    String?      @unique
  recipeCode   String?      @unique
  category     String?
  name         String
  yieldQty     Float        @default(1)
  yieldUnit    String       @default("KG")
  instructions String?
  estimatedDurationMinutes Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  productions  Production[]
  product      Product?     @relation(fields: [productId], references: [id])
  recipeItems  RecipeItem[]
}

model RecipeCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeItem {
  id               String        @id @default(uuid())
  recipeId         String
  inventoryItemId  String
  quantityRequired Float
  unit             String        @default("g")
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recipe           Recipe        @relation(fields: [recipeId], references: [id])
}

model Production {
  id             String           @id @default(uuid())
  productionType String
  recipeId       String
  quantity       Float
  franchiseId    String
  status         ProductionStatus @default(PENDING)
  producedBy     String?
  producedAt     DateTime         @default(now())
  customerId     String?
  endTime        DateTime?
  expiryDate     DateTime?
  startTime      DateTime?
  actualYield    Float?
  currentStage   ProductionStage  @default(QUEUED)
  stageUpdatedAt DateTime?
  operatorId     String?
  remarks        String?
  operator       Employee?        @relation(fields: [operatorId], references: [id])
  batches        ProductBatch[]
  customer       Customer?        @relation(fields: [customerId], references: [id])
  franchise      Franchise        @relation(fields: [franchiseId], references: [id])
  recipe         Recipe           @relation(fields: [recipeId], references: [id])
  items          ProductionItem[]
  stageLogs      ProductionStageLog[]
}

model ProductionStageLog {
  id           String          @id @default(uuid())
  productionId String
  stage        ProductionStage
  enteredAt    DateTime        @default(now())
  production   Production      @relation(fields: [productionId], references: [id])
}

enum ProductionStage {
  QUEUED
  MIXING
  COOKING
  COOLING
  READY_FOR_QC
}

enum PackagingStatus {
  PENDING
  PARTIALLY_PACKED
  PACKAGED
}

model ProductBatch {
  id              String             @id @default(uuid())
  productId       String
  productionId    String?
  quantity        Float
  expiryDate      DateTime?
  batchCode       String?
  createdAt       DateTime           @default(now())
  franchiseId     String?
  mfgDate         DateTime?          @default(now())
  qcStatus        String?            @default("PENDING") // PENDING, APPROVED, REJECTED, REWORK
  moistureCheck   Float?
  colorCheck      String?
  textureCheck    String?
  rejectionQty    Float?             @default(0)
  approvedQty     Float?             @default(0)
  packagingStatus PackagingStatus?   @default(PENDING)
  packagedQty     Float?             @default(0)
  cartonedQty     Float?             @default(0)
  franchise       Franchise?         @relation(fields: [franchiseId], references: [id])
  product         Product            @relation(fields: [productId], references: [id])
  production      Production?        @relation(fields: [productionId], references: [id])
  packagings      ProductPackaging[]
  cartons         Carton[]
}

model Carton {
  id              String       @id @default(uuid())
  cartonCode      String       @unique
  batchId         String
  cartonSize      String
  unitsPerCarton  Int
  cartonCount     Int
  totalUnits      Int
  weightPerCarton Float?
  franchiseId     String?
  createdBy       String?
  createdAt       DateTime     @default(now())
  batch           ProductBatch @relation(fields: [batchId], references: [id])
  franchise       Franchise?   @relation(fields: [franchiseId], references: [id])
}

model ProductPackaging {
  id              String       @id @default(uuid())
  batchId         String
  packetSize      String // e.g. "100g", "500g", "1KG"
  quantityPackets Int
  totalWeight     Float // quantityPackets * size
  barcode         String       @unique
  printedLabels   Boolean      @default(false)
  createdAt       DateTime     @default(now())
  batch           ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model FranchiseOrder {
  id                   String               @id @default(uuid())
  orderNumber          String               @unique
  franchiseId          String
  status               FranchiseOrderStatus @default(PENDING)
  totalAmount          Float
  paymentType          PaymentType          @default(CREDIT)
  paymentStatus        String               @default("UNPAID")
  notes                String?
  expectedDispatchDate DateTime?
  actualDispatchDate   DateTime?
  delayStatus          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deliveryCharges      Float                @default(0)
  priority             String               @default("NORMAL")
  subtotal             Float                @default(0)
  taxAmount            Float                @default(0)
  franchise            Franchise            @relation(fields: [franchiseId], references: [id])
  items                FranchiseOrderItem[]
  returnOrders         ReturnOrder[]
}

model FranchiseOrderItem {
  id          String         @id @default(uuid())
  orderId     String
  productId   String
  quantity    Float
  unitPrice   Float
  totalAmount Float
  productType ProductType    @default(FINISHED_GOOD)
  order       FranchiseOrder @relation(fields: [orderId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
}

model ProductionItem {
  id              String        @id @default(uuid())
  productionId    String
  inventoryItemId String
  usedQuantity    Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  production      Production    @relation(fields: [productionId], references: [id])
}

model StockRequest {
  id          String             @id @default(uuid())
  franchiseId String
  status      StockRequestStatus @default(PENDING)
  requestedBy String?
  requestedAt DateTime           @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  franchise   Franchise          @relation(fields: [franchiseId], references: [id])
  items       StockRequestItem[]
}

model StockRequestItem {
  id              String        @id @default(uuid())
  stockRequestId  String
  inventoryItemId String
  requestedQty    Float
  approvedQty     Float?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  stockRequest    StockRequest  @relation(fields: [stockRequestId], references: [id])
}

model StockTransfer {
  id           String              @id @default(uuid())
  fromBranchId String
  toBranchId   String
  status       StockTransferStatus @default(PENDING)
  initiatedBy  String?
  approvedBy   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  fromBranch   Franchise           @relation("OutgoingTransfers", fields: [fromBranchId], references: [id])
  toBranch     Franchise           @relation("IncomingTransfers", fields: [toBranchId], references: [id])
  items        StockTransferItem[]
}

model StockTransferItem {
  id              String        @id @default(uuid())
  transferId      String
  inventoryItemId String
  quantity        Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  transfer        StockTransfer @relation(fields: [transferId], references: [id])
}

model Order {
  id                 String      @id @default(uuid())
  invoiceNum         String      @unique
  customerId         String?
  branchId           String?
  franchiseId        String
  orderType          String      @default("DINE_IN")
  status             OrderStatus @default(COMPLETED)
  subTotal           Float
  taxAmount          Float
  discountAmount     Float       @default(0)
  totalAmount        Float
  paymentStatus      String      @default("PAID")
  paymentType        String      @default("CASH")
  stateOfSupply      String?
  inventory_deducted Boolean     @default(false)
  createdAt          DateTime    @default(now())
  delivery           Delivery?
  invoice            Invoice?
  customer           Customer?   @relation(fields: [customerId], references: [id])
  franchise          Franchise   @relation(fields: [franchiseId], references: [id])
  orderItems         OrderItem[]
  payments           Payment[]
  returns            ReturnOrder[]
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  quantity    Float
  unit        String  @default("NONE")
  price       Float
  discountPct Float   @default(0)
  taxAmount   Float?
  totalAmount Float?
  batchNumber String?
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                  String                @id @default(uuid())
  orderId             String?
  paymentMode         PaymentMode           @default(CASH)
  paidAmount          Float
  transactionRef      String?
  status              String                @default("SUCCESS")
  invoiceId           String?
  createdAt           DateTime              @default(now())
  accountId           String?
  entityId            String?
  entityType          String?
  type                AccountingPaymentType @default(INVOICE_LINKED)
  approvedBy          String?
  cancelledAt         DateTime?
  createdBy           String?
  isCancelled         Boolean               @default(false)
  linkedDocId         String?
  linkedDocType       LinkedDocType?
  paymentNumber       String?               @unique
  reversalOfPaymentId String?
  sourceModule        PaymentSourceModule   @default(MANUAL)
  vendorInvoiceId     String?
  account             Account?              @relation(fields: [accountId], references: [id])
  invoice             Invoice?              @relation(fields: [invoiceId], references: [id])
  order               Order?                @relation(fields: [orderId], references: [id])
  vendorInvoice       VendorInvoice?        @relation(fields: [vendorInvoiceId], references: [id])
}

model Invoice {
  id                 String    @id @default(uuid())
  orderId            String    @unique
  totalAmount        Float
  taxAmount          Float
  finalAmount        Float
  roundOff           Float     @default(0)
  status             String    @default("PAID")
  termsAndConditions String?
  description        String?
  notes              String?
  createdAt          DateTime  @default(now())
  order              Order     @relation(fields: [orderId], references: [id])
  payments           Payment[]
}

model Account {
  id              String           @id @default(uuid())
  name            String
