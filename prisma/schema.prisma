generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  phone         String?        @unique
  passwordHash  String
  roleId        String
  franchiseId   String?
  branchId      String?
  is_active     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activityLogs  ActivityLog[]
  employee      Employee?
  refreshTokens RefreshToken[]
  franchise     Franchise?     @relation(fields: [franchiseId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Customer {
  id             String           @id @default(uuid())
  name           String
  phone          String?          @unique
  email          String?          @unique
  loyaltyPoints  Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ledgerEntries  CustomerLedger[]
  orders         Order[]
  productions    Production[]
  quotations     Quotation[]
  returnOrders   ReturnOrder[]
  salesOrders    SalesOrder[]
}

model CustomerLedger {
  id            String                @id @default(uuid())
  customerId    String
  type          LedgerType
  amount        Float
  paymentMode   PaymentMode
  referenceType CustomerLedgerRefType
  referenceId   String?
  accountId     String?
  note          String?
  createdAt     DateTime              @default(now())
  account       Account?              @relation(fields: [accountId], references: [id])
  customer      Customer              @relation(fields: [customerId], references: [id])
}

model Franchise {
  id                String             @id @default(uuid())
  name              String
  location          String
  ownerName         String
  contactNum        String
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activityLogs      ActivityLog[]
  expenses          Expense[]
  franchiseOrders   FranchiseOrder[]
  franchiseRequests FranchiseRequest[]
  inventory         InventoryItem[]
  orders            Order[]
  productions       Production[]
  stockRequests     StockRequest[]
  outgoingTransfers StockTransfer[]    @relation("OutgoingTransfers")
  incomingTransfers StockTransfer[]    @relation("IncomingTransfers")
  users             User[]
}

model InventoryItem {
  id              String                 @id @default(uuid())
  name            String
  sku             String
  category        ItemCategory
  currentStock    Float
  unit            String
  minimumStock    Float                  @default(10)
  batchNo         String?
  expiryDate      DateTime?
  franchiseId     String
  vendorId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  gstRate         Float                  @default(5)
  hsnCode         String?
  isActive        Boolean                @default(true)
  grnItems        GoodsReceiptItem[]
  franchise       Franchise              @relation(fields: [franchiseId], references: [id])
  vendor          Vendor?                @relation(fields: [vendorId], references: [id])
  poItems         ProcurementOrderItem[]
  productionItems ProductionItem[]
  recipeItems     RecipeItem[]
  movements       StockMovement[]
  requestItems    StockRequestItem[]
  transferItems   StockTransferItem[]
  vendors         VendorMaterial[]
  wastage         Wastage[]

  @@unique([sku, franchiseId])
}

model StockMovement {
  id            String            @id @default(uuid())
  itemId        String
  movementType  StockMovementType
  quantity      Float
  referenceType String?
  referenceId   String?
  note          String?
  createdBy     String?
  createdAt     DateTime          @default(now())
  item          InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Vendor {
  id                String             @id @default(uuid())
  name              String
  contact           String
  email             String?
  rating            Float?             @default(5.0)
  createdAt         DateTime           @default(now())
  address           String?
  manualAdvanceAdj  Float              @default(0)
  manualPurchaseAdj Float              @default(0)
  remark            String?
  items             InventoryItem[]
  orders            ProcurementOrder[]
  rfqs              PurchaseRFQ[]
  purchaseReturns   PurchaseReturn[]
  invoices          VendorInvoice[]
  ledgerEntries     VendorLedger[]
  suppliedMaterials VendorMaterial[]
}

model VendorLedger {
  id            String                    @id @default(uuid())
  vendorId      String
  amount        Float
  paymentMode   PaymentMode
  referenceType VendorLedgerReferenceType
  referenceId   String?
  note          String?
  createdAt     DateTime                  @default(now())
  accountId     String?
  type          LedgerType
  account       Account?                  @relation(fields: [accountId], references: [id])
  vendor        Vendor                    @relation(fields: [vendorId], references: [id])
}

model VendorMaterial {
  vendorId    String
  materialId  String
  price       Float?
  lastUpdated DateTime      @default(now())
  quantity    Float?
  material    InventoryItem @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor      Vendor        @relation(fields: [vendorId], references: [id])

  @@id([vendorId, materialId])
}

model ProcurementOrder {
  id                   String                 @id @default(uuid())
  vendorId             String
  status               POStatus               @default(PENDING)
  totalAmount          Float
  advancePaid          Float                  @default(0)
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  notes                String?
  items                Json?
  received             Boolean                @default(false)
  createdAt            DateTime               @default(now())
  balance              Float                  @default(0)
  cgst                 Float                  @default(0)
  igst                 Float                  @default(0)
  paid                 Float                  @default(0)
  poNumber             String?                @unique
  sgst                 Float                  @default(0)
  subtotal             Float                  @default(0)
  expenses             Expense[]
  goodsReceipts        GoodsReceipt[]
  vendor               Vendor                 @relation(fields: [vendorId], references: [id])
  poItems              ProcurementOrderItem[]
  purchaseReturns      PurchaseReturn[]
  invoices             VendorInvoice[]
}

model ProcurementOrderItem {
  id               String           @id @default(uuid())
  poId             String
  inventoryItemId  String
  quantity         Float
  price            Float
  cgst             Float            @default(0)
  gstRate          Float            @default(5)
  hsnCode          String?
  igst             Float            @default(0)
  itemName         String?
  sgst             Float            @default(0)
  subtotal         Float            @default(0)
  total            Float            @default(0)
  inventoryItem    InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
}

model GoodsReceipt {
  id               String             @id @default(uuid())
  poId             String
  receivedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  receivedBy       String?
  status           GRNStatus          @default(PENDING)
  procurementOrder ProcurementOrder   @relation(fields: [poId], references: [id])
  items            GoodsReceiptItem[]
  invoices         VendorInvoice[]
}

model GoodsReceiptItem {
  id            String        @id @default(uuid())
  grnId         String
  materialId    String
  quantity      Float
  receivedQty   Float
  acceptedQty   Float
  rejectedQty   Float
  price         Float
  grn           GoodsReceipt  @relation(fields: [grnId], references: [id])
  inventoryItem InventoryItem @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model VendorInvoice {
  id               String           @id @default(uuid())
  vendorId         String
  poId             String
  grnId            String?
  invoiceNumber    String           @unique
  amount           Float
  status           InvoiceStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  grn              GoodsReceipt?    @relation(fields: [grnId], references: [id])
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
  vendor           Vendor           @relation(fields: [vendorId], references: [id])
}

model Product {
  id              String               @id @default(uuid())
  name            String
  sku             String?              @unique
  description     String?
  basePrice       Float
  category        String?
  taxPercent      Float                @default(5)
  isActive        Boolean              @default(true)
  emoji           String?
  isVeg           Boolean              @default(true)
  is_menu_item    Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hsnCode         String?
  productType     ProductType          @default(FINISHED_GOOD)
  franchiseOrders FranchiseOrderItem[]
  orderItems      OrderItem[]
  batches         ProductBatch[]
  recipe          Recipe?
}

model Recipe {
  id           String       @id @default(uuid())
  productId    String       @unique
  name         String
  yieldQty     Float        @default(1)
  instructions String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  productions  Production[]
  product      Product      @relation(fields: [productId], references: [id])
  recipeItems  RecipeItem[]
}

model RecipeItem {
  id               String        @id @default(uuid())
  recipeId         String
  inventoryItemId  String
  quantityRequired Float
  unit             String        @default("g")
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recipe           Recipe        @relation(fields: [recipeId], references: [id])
}

model Production {
  id             String           @id @default(uuid())
  productionType String
  recipeId       String
  quantity       Float
  franchiseId    String
  status         ProductionStatus @default(PENDING)
  producedBy     String?
  producedAt     DateTime         @default(now())
  customerId     String?
  endTime        DateTime?
  expiryDate     DateTime?
  startTime      DateTime?
  batches        ProductBatch[]
  customer       Customer?        @relation(fields: [customerId], references: [id])
  franchise      Franchise        @relation(fields: [franchiseId], references: [id])
  recipe         Recipe           @relation(fields: [recipeId], references: [id])
  items          ProductionItem[]
}

model ProductBatch {
  id           String      @id @default(uuid())
  productId    String
  productionId String?
  quantity     Float
  expiryDate   DateTime?
  batchCode    String?
  createdAt    DateTime    @default(now())
  product      Product     @relation(fields: [productId], references: [id])
  production   Production? @relation(fields: [productionId], references: [id])
}

model FranchiseOrder {
  id                   String               @id @default(uuid())
  orderNumber          String               @unique
  franchiseId          String
  status               FranchiseOrderStatus @default(PENDING)
  totalAmount          Float
  paymentType          PaymentType          @default(COD)
  paymentStatus        String               @default("UNPAID")
  notes                String?
  expectedDispatchDate DateTime?
  actualDispatchDate   DateTime?
  delayStatus          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  franchise            Franchise            @relation(fields: [franchiseId], references: [id])
  items                FranchiseOrderItem[]
}

model FranchiseOrderItem {
  id          String         @id @default(uuid())
  orderId     String
  productId   String
  quantity    Float
  unitPrice   Float
  totalAmount Float
  productType ProductType    @default(FINISHED_GOOD)
  order       FranchiseOrder @relation(fields: [orderId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
}

model ProductionItem {
  id              String        @id @default(uuid())
  productionId    String
  inventoryItemId String
  usedQuantity    Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  production      Production    @relation(fields: [productionId], references: [id])
}

model StockRequest {
  id          String             @id @default(uuid())
  franchiseId String
  status      StockRequestStatus @default(PENDING)
  requestedBy String?
  requestedAt DateTime           @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  franchise   Franchise          @relation(fields: [franchiseId], references: [id])
  items       StockRequestItem[]
}

model StockRequestItem {
  id              String        @id @default(uuid())
  stockRequestId  String
  inventoryItemId String
  requestedQty    Float
  approvedQty     Float?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  stockRequest    StockRequest  @relation(fields: [stockRequestId], references: [id])
}

model StockTransfer {
  id           String              @id @default(uuid())
  fromBranchId String
  toBranchId   String
  status       StockTransferStatus @default(PENDING)
  initiatedBy  String?
  approvedBy   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  fromBranch   Franchise           @relation("OutgoingTransfers", fields: [fromBranchId], references: [id])
  toBranch     Franchise           @relation("IncomingTransfers", fields: [toBranchId], references: [id])
  items        StockTransferItem[]
}

model StockTransferItem {
  id              String        @id @default(uuid())
  transferId      String
  inventoryItemId String
  quantity        Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  transfer        StockTransfer @relation(fields: [transferId], references: [id])
}

model Order {
  id                 String      @id @default(uuid())
  invoiceNum         String      @unique
  customerId         String?
  branchId           String?
  franchiseId        String
  orderType          String      @default("DINE_IN")
  status             OrderStatus @default(COMPLETED)
  subTotal           Float
  taxAmount          Float
  discountAmount     Float       @default(0)
  totalAmount        Float
  paymentStatus      String      @default("PAID")
  inventory_deducted Boolean     @default(false)
  createdAt          DateTime    @default(now())
  delivery           Delivery?
  invoice            Invoice?
  customer           Customer?   @relation(fields: [customerId], references: [id])
  franchise          Franchise   @relation(fields: [franchiseId], references: [id])
  orderItems         OrderItem[]
  payments           Payment[]
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  price       Float
  taxAmount   Float?
  totalAmount Float?
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}

model Payment {
  id             String                @id @default(uuid())
  orderId        String?
  paymentMode    PaymentMode           @default(CASH)
  paidAmount     Float
  transactionRef String?
  status         String                @default("SUCCESS")
  invoiceId      String?
  createdAt      DateTime              @default(now())
  accountId      String?
  entityId       String?
  entityType     String?
  type           AccountingPaymentType @default(INVOICE_LINKED)
  account        Account?              @relation(fields: [accountId], references: [id])
  invoice        Invoice?              @relation(fields: [invoiceId], references: [id])
  order          Order?                @relation(fields: [orderId], references: [id])
}

model Invoice {
  id          String    @id @default(uuid())
  orderId     String    @unique
  totalAmount Float
  taxAmount   Float
  finalAmount Float
  status      String    @default("PAID")
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id])
  payments    Payment[]
}

model Account {
  id              String           @id @default(uuid())
  name            String
  type            AccountType
  balance         Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customerLedgers CustomerLedger[]
  expenses        Expense[]
  payments        Payment[]
  vendorLedgers   VendorLedger[]
}

model Expense {
  id              String            @id @default(uuid())
  franchiseId     String?
  category        String
  amount          Float
  date            DateTime          @default(now())
  description     String?
  purchaseOrderId String?
  accountId       String?
  account         Account?          @relation(fields: [accountId], references: [id])
  franchise       Franchise?        @relation(fields: [franchiseId], references: [id])
  purchaseOrder   ProcurementOrder? @relation(fields: [purchaseOrderId], references: [id])
}

model Wastage {
  id              String        @id @default(uuid())
  inventoryItemId String
  quantity        Float
  reason          String
  cost            Float
  date            DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model Delivery {
  id            String   @id @default(uuid())
  orderId       String   @unique
  riderName     String?
  status        String   @default("PENDING")
  otp           String?
  customerPhone String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pipeline {
  id          String    @id @default(uuid())
  name        String
  description String?
  stages      String[]  @default(["Open", "Contacted", "Proposal Sent", "Deal Done", "Lost", "Not Serviceable"])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  crmForms    CRMForm[]
  leads       Lead[]
}

model Lead {
  id              String     @id @default(uuid())
  pipelineId      String
  contactName     String
  orgName         String?
  email           String?
  phone           String?
  designation     String?
  contactCountry  String?
  customerCountry String?
  customerCity    String?
  leadSource      String?
  budget          Float?
  subject         String?
  status          LeadStatus @default(NEW)
  assigneeId      String?
  creatorId       String?
  followUpDate    DateTime?
  closedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  pipeline        Pipeline   @relation(fields: [pipelineId], references: [id])
}

model CRMForm {
  id            String   @id @default(uuid())
  name          String
  pipelineId    String
  status        String   @default("ACTIVE")
  capturedLeads Int      @default(0)
  creatorId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pipeline      Pipeline @relation(fields: [pipelineId], references: [id])
}

 model Employee {
  id                    String           @id @default(uuid())
  userId                String           @unique
  employeeCode          String           @unique
  department            String?
  designation           String?
  dateOfJoining         DateTime
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  bankAccount           String?
  ifscCode              String?
  panNumber             String?
  pfNumber              String?
  esiNumber             String?
  salaryStructureId     String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  salary                Decimal?
  aadhaarNumber         String?
  allowances            Decimal?         @default(0)
  altMobile             String?
  bankAccountHolder     String?
  bankBranch            String?
  bankName              String?
  bloodGroup            String?
  currentCity           String?
  currentPincode        String?
  currentState          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  employeeType          String?          @default("Permanent")
  hasAttendanceAccess   Boolean          @default(false)
  hasErpAccess          Boolean          @default(false)
  hasLeaveAccess        Boolean          @default(false)
  hasPayrollAccess      Boolean          @default(false)
  incentives            Decimal?         @default(0)
  isOvertimeEligible    Boolean          @default(false)
  maritalStatus         String?
  mobile                String?
  paymentMethod         String?          @default("Bank Transfer")
  permArea              String?
  permCity              String?
  permDistrict          String?
  permDoorNo            String?
  permPincode           String?
  permState             String?
  permStreet            String?
  personalEmail         String?
  reportingManager      String?
  salaryCreditDate      String?
  salaryType            String?          @default("Monthly")
  shiftTiming           String?
  upiId                 String?
  verificationStatus    String?          @default("PENDING")
  workLocation          String?
  salaryStructure       SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  user                  User             @relation(fields: [userId], references: [id])
  shifts                EmployeeShift[]
  leaves                Leave[]
  payslips              Payslip[]
}

model LeaveType {
  id      String  @id @default(uuid())
  name    String
  maxDays Int
  isPaid  Boolean @default(true)
  leaves  Leave[]
}

model Leave {
  id          String      @id @default(uuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())
  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
}

model Shift {
  id        String          @id @default(uuid())
  name      String
  startTime String
  endTime   String
  employees EmployeeShift[]
}

model EmployeeShift {
  id         String   @id @default(uuid())
  employeeId String
  shiftId    String
  date       DateTime
  employee   Employee @relation(fields: [employeeId], references: [id])
  shift      Shift    @relation(fields: [shiftId], references: [id])
}

model SalaryComponent {
  id              String                @id @default(uuid())
  name            String
  type            ComponentType
  calculationType String                @default("FIXED")
  value           Float
  isActive        Boolean               @default(true)
  structureItems  SalaryStructureItem[]
}

model SalaryStructure {
  id          String                @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  employees   Employee[]
  items       SalaryStructureItem[]
}

model SalaryStructureItem {
  id            String          @id @default(uuid())
  structureId   String
  componentId   String
  overrideValue Float?
  component     SalaryComponent @relation(fields: [componentId], references: [id])
  structure     SalaryStructure @relation(fields: [structureId], references: [id])
}

model Payroll {
  id          String    @id @default(uuid())
  month       Int
  year        Int
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  payslips    Payslip[]
}

model Payslip {
  id              String    @id @default(uuid())
  payrollId       String?
  employeeId      String
  month           Int
  year            Int
  basicSalary     Float
  totalEarnings   Float
  totalDeductions Float
  netSalary       Float
  otHours         Float     @default(0)
  otAmount        Float     @default(0)
  components      Json
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  employee        Employee  @relation(fields: [employeeId], references: [id])
  payroll         Payroll?  @relation(fields: [payrollId], references: [id])
}

model Quotation {
  id               String          @id @default(uuid())
  quotationNumber  String          @unique
  customerId       String?
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  validUntil       DateTime?
  status           QuotationStatus @default(DRAFT)
  subTotal         Float
  taxAmount        Float
  discountAmount   Float           @default(0)
  totalAmount      Float
  termsConditions  String?
  notes            String?
  createdBy        String?
  convertedOrderId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customer         Customer?       @relation(fields: [customerId], references: [id])
  items            QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  productId   String?
  productName String
  quantity    Float
  unit        String?
  rate        Float
  taxPercent  Float     @default(0)
  taxAmount   Float     @default(0)
  totalAmount Float
  quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model SalesOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  quotationId     String?
  customerId      String?
  customerName    String?
  status          SalesOrderStatus @default(PENDING)
  subTotal        Float
  taxAmount       Float
  discountAmount  Float            @default(0)
  totalAmount     Float
  deliveryDate    DateTime?
  deliveryAddress String?
  notes           String?
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  returns         ReturnOrder[]
  customer        Customer?        @relation(fields: [customerId], references: [id])
  items           SalesOrderItem[]
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  productId    String?
  productName  String
  quantity     Float
  unit         String?
  rate         Float
  taxPercent   Float      @default(0)
  taxAmount    Float      @default(0)
  totalAmount  Float
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model ReturnOrder {
  id           String       @id @default(uuid())
  returnNumber String       @unique
  salesOrderId String?
  customerId   String?
  reason       String
  status       ReturnStatus @default(PENDING)
  refundAmount Float
  refundMethod String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        ReturnItem[]
  customer     Customer?    @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder?  @relation(fields: [salesOrderId], references: [id])
}

model ReturnItem {
  id          String      @id @default(uuid())
  returnId    String
  productId   String?
  productName String
  quantity    Float
  rate        Float
  totalAmount Float
  condition   String?
  return      ReturnOrder @relation(fields: [returnId], references: [id])
}

model PurchaseRFQ {
  id               String    @id @default(uuid())
  rfqNumber        String    @unique
  vendorId         String
  status           RFQStatus @default(SENT)
  responseDeadline DateTime?
  notes            String?
  quotedAmount     Float?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  items            RFQItem[]
}

model RFQItem {
  id         String      @id @default(uuid())
  rfqId      String
  itemName   String
  quantity   Float
  unit       String
  quotedRate Float?
  notes      String?
  rfq        PurchaseRFQ @relation(fields: [rfqId], references: [id])
}

model PurchaseReturn {
  id                 String               @id @default(uuid())
  returnNumber       String               @unique
  procurementOrderId String?
  vendorId           String
  reason             String
  status             String               @default("PENDING")
  refundAmount       Float
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  procurementOrder   ProcurementOrder?    @relation(fields: [procurementOrderId], references: [id])
  vendor             Vendor               @relation(fields: [vendorId], references: [id])
  items              PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id          String         @id @default(uuid())
  returnId    String
  itemName    String
  quantity    Float
  unit        String
  rate        Float
  totalAmount Float
  return      PurchaseReturn @relation(fields: [returnId], references: [id])
}

model ActivityLog {
  id                String     @id @default(uuid())
  userId            String
  targetFranchiseId String?
  action            String
  entityType        String?
  entityId          String?
  details           Json?
  createdAt         DateTime   @default(now())
  franchise         Franchise? @relation(fields: [targetFranchiseId], references: [id])
  user              User       @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  group       String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
}

model FranchiseRequest {
  id            String    @id @default(uuid())
  franchiseId   String
  requestType   String
  status        String    @default("PENDING")
  details       Json?
  adminResponse String?
  managedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  franchise     Franchise @relation(fields: [franchiseId], references: [id])
}

model FinancialPayment {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  entity      String
  entityType  String
  flowType    String
  amount      Float
  method      String
  status      String   @default("PAID")
  reference   String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type        String?
}

