model InventoryBatch {
  id                              String                           @id @default(uuid())
  inventoryItemId                 String
  batchNumber                     String
  lotNumber                       String?
  // The actual Purchase Bill reference (BILL-<PO>-<seq>), always populated
  // at GRN approval regardless of whether a lot/vendor-batch number was also
  // entered. batchNumber prioritizes the lot code for internal traceability,
  // but the business-facing reference for raw-material consumption should be
  // this field. Left null for production/QC/packaging-created batches (bulk
  // and retail lots), which already carry the correct reference in
  // batchNumber (= ProductBatch.batchCode).
  billNumber                      String?
  mfgDate                         DateTime?
  expDate                         DateTime?
  initialQty                      Float
  currentQty                      Float
  unitCost                        Float?
  productBatchId                  String?
  warehouseId                     String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  status                          InventoryStockState              @default(QC_HOLD)
  inventoryItem                   InventoryItem                    @relation(fields: [inventoryItemId], references: [id])
  productBatch                    ProductBatch?                    @relation(fields: [productBatchId], references: [id])
  warehouse                       Warehouse?                       @relation(fields: [warehouseId], references: [id])
  stockMovements                  StockMovement[]
  inventoryReservationAllocations InventoryReservationAllocation[]

  // Every recall query (getBatchQuantities, locateDistribution,
  // findCrossBatchAffectedIds' block/unblock updates) filters by
  // productBatchId; depleteBatchesFIFO's hot path filters by
  // inventoryItemId + status on every sale/dispatch/production consumption.
  // Neither had an index before.
  @@index([productBatchId])
  @@index([inventoryItemId, status])
}

