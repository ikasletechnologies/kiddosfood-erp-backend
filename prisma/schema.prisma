generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String
  franchiseId   String?
  branchId      String?
  is_active     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(FRANCHISE_ADMIN)
  activityLogs  ActivityLog[]
  employee      Employee?
  refreshTokens RefreshToken[]
  franchise     Franchise?     @relation(fields: [franchiseId], references: [id])
}

model WorkflowRequest {
  id            String            @id @default(uuid())
  displayId     String            @unique
  category      WorkflowCategory
  title         String
  amount        Float?
  currentStage  String
  initiatedBy   String
  franchiseId   String?
  dateInitiated DateTime          @default(now())
  details       Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  history       WorkflowHistory[]
  franchise     Franchise?        @relation(fields: [franchiseId], references: [id])
}

model WorkflowHistory {
  id         String          @id @default(uuid())
  requestId  String
  stage      String
  timestamp  DateTime        @default(now())
  userId     String?
  userLabel  String
  notes      String?
  isOverride Boolean         @default(false)
  request    WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Customer {
  id                 String            @id @default(uuid())
  name               String
  phone              String?           @unique
  email              String?           @unique
  loyaltyPoints      Float             @default(0)
  address            String?
  state              String?
  district           String?
  city               String?
  pincode            String?
  shippingAddress    String?
  gstNumber          String?
  gstType            String?
  openingBalance     Float             @default(0)
  openingBalanceType String?
  asOfDate           DateTime?
  creditLimit        Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  franchiseId        String?
  franchise          Franchise?        @relation(fields: [franchiseId], references: [id])
  ledgerEntries      CustomerLedger[]
  deliveryChallans   DeliveryChallan[]
  orders             Order[]
  productions        Production[]
  proformaInvoices   ProformaInvoice[]
  quotations         Quotation[]
  returnOrders       ReturnOrder[]
  salesOrders        SalesOrder[]

  @@index([franchiseId])
}

model Dealer {
  id               String            @id @default(uuid())
  name             String
  phone            String?           @unique
  email            String?           @unique
  address          String?
  status           String            @default("ACTIVE")
  franchiseId      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  franchise        Franchise         @relation(fields: [franchiseId], references: [id])
  deliveryChallans DeliveryChallan[]

  @@index([franchiseId])
}

model BusinessPartner {
  id          String      @id @default(uuid())
  name        String
  type        PartnerType
  phone       String?     @unique
  email       String?     @unique
  address     String?
  status      String      @default("ACTIVE")
  franchiseId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  franchise   Franchise   @relation(fields: [franchiseId], references: [id])
}

model CustomerLedger {
  id            String                @id @default(uuid())
  customerId    String
  type          LedgerType
  amount        Float
  paymentMode   PaymentMode
  referenceType CustomerLedgerRefType
  referenceId   String?
  accountId     String?
  note          String?
  createdAt     DateTime              @default(now())
  account       Account?              @relation(fields: [accountId], references: [id])
  customer      Customer              @relation(fields: [customerId], references: [id])
}

model Franchise {
  id                 String             @id @default(uuid())
  name               String
  location           String
  ownerName          String
  contactNum         String
  status             String             @default("ACTIVE")
  isHQ               Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dashboardPassword  String?
  creditLimit        Float              @default(0)
  outstandingAmount  Float              @default(0)
  walletBalance      Float              @default(0)
  primaryWarehouseId String?
  accounts           Account[]
  activityLogs       ActivityLog[]
  businessPartners   BusinessPartner[]
  cartons            Carton[]
  cheques            Cheque[]
  customers          Customer[]
  dailySettlements   DailySettlement[]
  dealers            Dealer[]
  expenses           Expense[]
  primaryWarehouse   Warehouse?         @relation("PrimaryWarehouse", fields: [primaryWarehouseId], references: [id])
  ledgerEntries      FranchiseLedger[]
  franchiseOrders    FranchiseOrder[]
  franchiseRequests  FranchiseRequest[]
  inventory          InventoryItem[]
  loanAccounts       LoanAccount[]
  orders             Order[]
  procurementOrders  ProcurementOrder[]
  productBatches     ProductBatch[]
  productions        Production[]
  returnOrders       ReturnOrder[]
  stockRequests      StockRequest[]
  outgoingTransfers  StockTransfer[]    @relation("OutgoingTransfers")
  incomingTransfers  StockTransfer[]    @relation("IncomingTransfers")
  users              User[]
  wasteEntries       WasteEntry[]
  workflowRequests   WorkflowRequest[]
}

model DailySettlement {
  id           String    @id @default(uuid())
  franchiseId  String
  businessDate DateTime
  cashTotal    Float     @default(0)
  upiTotal     Float     @default(0)
  cardTotal    Float     @default(0)
  otherTotal   Float     @default(0)
  grandTotal   Float     @default(0)
  refundTotal  Float     @default(0)
  netTotal     Float     @default(0)
  orderCount   Int       @default(0)
  closedBy     String?
  createdAt    DateTime  @default(now())
  franchise    Franchise @relation(fields: [franchiseId], references: [id])

  @@unique([franchiseId, businessDate])
}

model Cheque {
  id           String       @id @default(uuid())
  chequeNumber String       @unique
  bankName     String
  payeeName    String
  entityBranch String?
  amount       Float
  type         ChequeType   @default(PAYABLE)
  issueDate    DateTime
  dueDate      DateTime
  status       ChequeStatus @default(PENDING)
  notes        String?
  franchiseId  String
  accountId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  account      Account?     @relation(fields: [accountId], references: [id])
  franchise    Franchise    @relation(fields: [franchiseId], references: [id])
}

model InventoryItem {
  id                              String                           @id @default(uuid())
  name                            String
  sku                             String
  category                        ItemCategory
  currentStock                    Float
  unit                            String
  minimumStock                    Float                            @default(10)
  batchNo                         String?
  expiryDate                      DateTime?
  franchiseId                     String?
  vendorId                        String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  gstRate                         Float                            @default(5)
  hsnCode                         String?
  isActive                        Boolean                          @default(true)
  basePrice                       Float?                           @default(0)
  costPrice                       Float?                           @default(0)
  franchisePrice                  Float?                           @default(0)
  dealerPrice                     Float?                           @default(0)
  customerPrice                   Float?                           @default(0)
  discountType                    String?                          @default("PERCENT")
  discountValue                   Float?                           @default(0)
  baseUnitId                      String?
  grnItems                        GoodsReceiptItem[]
  inventoryBatches                InventoryBatch[]
  baseUnit                        Unit?                            @relation(fields: [baseUnitId], references: [id])
  franchise                       Franchise?                       @relation(fields: [franchiseId], references: [id])
  vendor                          Vendor?                          @relation(fields: [vendorId], references: [id])
  conversions                     ItemUnitConversion[]
  poItems                         ProcurementOrderItem[]
  productionItems                 ProductionItem[]
  purchaseRequestItems            PurchaseRequestItem[]
  recipeItems                     RecipeItem[]
  movements                       StockMovement[]
  requestItems                    StockRequestItem[]
  transferItems                   StockTransferItem[]
  vendors                         VendorMaterial[]
  wasteEntries                    WasteEntry[]
  inventoryReservationAllocations InventoryReservationAllocation[]

  @@unique([sku, franchiseId])
}

model WasteEntry {
  id                 String            @id @default(uuid())
  inventoryItemId    String
  franchiseId        String?
  warehouseId        String?
  quantity           Float
  reason             String
  note               String?
  costAtTime         Float?
  productPackagingId String?
  createdAt          DateTime          @default(now())
  franchise          Franchise?        @relation(fields: [franchiseId], references: [id])
  inventoryItem      InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  productPackaging   ProductPackaging? @relation(fields: [productPackagingId], references: [id])
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
}

model StockMovement {
  id                   String            @id @default(uuid())
  itemId               String
  movementType         StockMovementType
  quantity             Float
  baseQty              Float?
  transactionUnit      String?
  unitId               String?
  referenceType        String?
  referenceId          String?
  note                 String?
  createdBy            String?
  createdAt            DateTime          @default(now())
  binId                String?
  warehouseId          String?
  batchId              String?
  unitCost             Float?
  // Full FIFO consumption breakdown (every InventoryBatch lot + qty +
  // productBatchId actually drawn from), populated whenever an outbound
  // movement spans more than one lot — mirrors ProductPackaging.bulkBreakdown
  // / ProductionItem.batchBreakdown. `batchId` above is left null in that
  // case (no single lot to report), which used to make multi-lot sales
  // impossible to trace back to a specific ProductBatch for recall/return
  // purposes. See RecallService.findRecallForSoldItem, which reads this to
  // determine whether a customer return traces back to a recalled batch.
  consumptionBreakdown Json?
  batch                InventoryBatch?   @relation(fields: [batchId], references: [id])
  bin                  WarehouseBin?     @relation(fields: [binId], references: [id])
  item                 InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit                 Unit?             @relation(fields: [unitId], references: [id])
  warehouse            Warehouse?        @relation(fields: [warehouseId], references: [id])

  @@index([movementType, createdAt])
  // RecallService's distributedQty/wastedQty queries filter batchId IN (...)
  // + quantity < 0 + referenceType IN (...) on every recall step.
  @@index([batchId, referenceType])
}

model Vendor {
  id                     String             @id @default(uuid())
  name                   String
  contact                String
  email                  String?
  address                String?
  state                  String?
  district               String?
  city                   String?
  pincode                String?
  shippingAddress        String?
  gstType                String?
  openingBalance         Float              @default(0)
  asOfDate               DateTime?
  creditLimit            Float?
  remark                 String?
  manualPurchaseAdj      Float              @default(0)
  manualAdvanceAdj       Float              @default(0)
  rating                 Float?             @default(5.0)
  createdAt              DateTime           @default(now())
  category               String?
  gstNumber              String?
  paymentTerms           PaymentTerms       @default(IMMEDIATE)
  status                 VendorStatus       @default(ACTIVE)
  vendorCode             String?            @unique
  paymentReminderEnabled Boolean            @default(false)
  paymentReminderDays    Int                @default(1)
  items                  InventoryItem[]
  orders                 ProcurementOrder[]
  purchaseReturns        PurchaseReturn[]
  invoices               VendorInvoice[]
  ledgerEntries          VendorLedger[]
  suppliedMaterials      VendorMaterial[]
  vendorQuotations       VendorQuotation[]
}

model VendorLedger {
  id                      String                    @id @default(uuid())
  vendorId                String
  amount                  Float
  referenceType           VendorLedgerReferenceType
  referenceId             String?
  note                    String?
  createdAt               DateTime                  @default(now())
  paymentMode             PaymentMode
  accountId               String?
  type                    LedgerType
  balanceAfterTransaction Float                     @default(0)
  sourceModule            VendorLedgerSource        @default(MANUAL)
  invoiceId               String?
  account                 Account?                  @relation(fields: [accountId], references: [id])
  invoice                 VendorInvoice?            @relation(fields: [invoiceId], references: [id])
  vendor                  Vendor                    @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model VendorMaterial {
  vendorId    String
  materialId  String
  price       Float?
  lastUpdated DateTime      @default(now())
  quantity    Float?
  material    InventoryItem @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor      Vendor        @relation(fields: [vendorId], references: [id])

  @@id([vendorId, materialId])
}

model ProcurementOrder {
  id                   String                 @id @default(uuid())
  vendorId             String
  status               POStatus               @default(PENDING_APPROVAL)
  totalAmount          Float
  advancePaid          Float                  @default(0)
  advanceApplied       Float                  @default(0)
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  notes                String?
  items                Json?
  received             Boolean                @default(false)
  createdAt            DateTime               @default(now())
  balance              Float                  @default(0)
  cgst                 Float                  @default(0)
  igst                 Float                  @default(0)
  paid                 Float                  @default(0)
  sgst                 Float                  @default(0)
  subtotal             Float                  @default(0)
  poNumber             String?                @unique
  brokerageCost        Float                  @default(0)
  freightCost          Float                  @default(0)
  invoiceStatus        InvoiceStatus          @default(PENDING)
  paymentStatus        POPaymentStatus        @default(UNPAID)
  transportCost        Float                  @default(0)
  unloadingCost        Float                  @default(0)
  deliveryInstructions String?
  internalNotes        String?
  vendorNotes          String?
  paymentTerms         String?
  approvedAt           DateTime?
  approvedBy           String?
  warehouseId          String?
  franchiseId          String?
  purchaseType         PurchaseType           @default(RAW_MATERIAL)
  discountAmount       Float                  @default(0)
  expenses             Expense[]
  goodsReceipts        GoodsReceipt[]
  franchise            Franchise?             @relation(fields: [franchiseId], references: [id])
  vendor               Vendor                 @relation(fields: [vendorId], references: [id])
  warehouse            Warehouse?             @relation(fields: [warehouseId], references: [id])
  poItems              ProcurementOrderItem[]
  purchaseReturns      PurchaseReturn[]
  invoices             VendorInvoice[]

  @@index([franchiseId, createdAt])
  @@index([createdAt])
}

model ProcurementOrderItem {
  id               String           @id @default(uuid())
  poId             String
  inventoryItemId  String?
  quantity         Float
  price            Float
  unit             String           @default("UNIT")
  cgst             Float            @default(0)
  gstRate          Float            @default(5)
  hsnCode          String?
  igst             Float            @default(0)
  itemName         String?
  sgst             Float            @default(0)
  subtotal         Float            @default(0)
  total            Float            @default(0)
  inventoryItem    InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
}

model GoodsReceipt {
  id               String             @id @default(uuid())
  poId             String
  receivedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  receivedBy       String?
  status           GRNStatus          @default(PENDING)
  freightCost      Float              @default(0)
  unloadingCost    Float              @default(0)
  procurementOrder ProcurementOrder   @relation(fields: [poId], references: [id])
  items            GoodsReceiptItem[]
  invoices         VendorInvoice[]
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  grnId               String
  materialId          String?
  quantity            Float
  receivedQty         Float
  acceptedQty         Float
  rejectedQty         Float
  price               Float
  poPrice             Float?
  priceOverridden     Boolean           @default(false)
  priceOverrideReason String?
  priceOverrideBy     String?
  priceOverrideAt     DateTime?
  unit                String            @default("UNIT")
  binId               String?
  expDate             DateTime?
  lotNumber           String?
  mfgDate             DateTime?
  qcStatus            QCStatus          @default(PENDING)
  vendorBatchNo       String?
  warehouseId         String?
  warehouseBinId      String?
  grn                 GoodsReceipt      @relation(fields: [grnId], references: [id])
  inventoryItem       InventoryItem?    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouseBin        WarehouseBin?     @relation(fields: [warehouseBinId], references: [id])
  warehouse           Warehouse?        @relation(fields: [warehouseId], references: [id])
  inspection          InspectionRecord?
}

model VendorInvoice {
  id               String           @id @default(uuid())
  vendorId         String
  poId             String
  grnId            String?
  invoiceNumber    String           @unique
  amount           Float
  status           InvoiceStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  billDate         DateTime?
  subtotal         Float?
  taxAmount        Float?
  cgst             Float?
  sgst             Float?
  igst             Float?
  discountAmount   Float?           @default(0)
  freightCost      Float?           @default(0)
  advanceApplied   Float            @default(0)
  warehouseId      String?
  // Bill payment TERMS (Cash vs Credit), distinct from how it's later
  // actually settled (Payment.paymentMode: CASH/BANK/UPI/CHEQUE). A Credit
  // bill that gets paid via bank transfer stays paymentType=CREDIT — only
  // its status moves to PAID. Defaults to CASH for pre-existing rows,
  // matching the same default already used on Order.paymentType.
  paymentType      String           @default("CASH")
  payments         Payment[]
  grn              GoodsReceipt?    @relation(fields: [grnId], references: [id])
  procurementOrder ProcurementOrder @relation(fields: [poId], references: [id])
  vendor           Vendor           @relation(fields: [vendorId], references: [id])
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id])
  ledgerEntries    VendorLedger[]
}

model Product {
  id              String               @id @default(uuid())
  name            String
  sku             String?              @unique
  description     String?
  basePrice       Float
  category        String?
  taxPercent      Float                @default(5)
  isActive        Boolean              @default(true)
  emoji           String?
  isVeg           Boolean              @default(true)
  is_menu_item    Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hsnCode         String?
  sacCode         String?
  discountType    String?              @default("PERCENT")
  discountValue   Float?               @default(0)
  productType     ProductType          @default(FINISHED_GOOD)
  shelfLifeDays   Int?
  franchiseOrders FranchiseOrderItem[]
  orderItems      OrderItem[]
  batches         ProductBatch[]
  recipe          Recipe?
}

model Recipe {
  id                       String       @id @default(uuid())
  productId                String?      @unique
  recipeCode               String?      @unique
  category                 String?
  name                     String
  yieldQty                 Float        @default(1)
  yieldUnit                String       @default("KG")
  instructions             String?
  estimatedDurationMinutes Int?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  productions              Production[]
  product                  Product?     @relation(fields: [productId], references: [id])
  recipeItems              RecipeItem[]
}

model RecipeCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeItem {
  id               String        @id @default(uuid())
  recipeId         String
  inventoryItemId  String
  quantityRequired Float
  unit             String        @default("g")
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recipe           Recipe        @relation(fields: [recipeId], references: [id])
}

model Production {
  id                  String               @id @default(uuid())
  productionBatchCode String?              @unique
  productionType      String
  recipeId            String
  quantity            Float
  franchiseId         String
  status              ProductionStatus     @default(PENDING)
  producedBy          String?
  producedAt          DateTime             @default(now())
  customerId          String?
  endTime             DateTime?
  expiryDate          DateTime?
  startTime           DateTime?
  actualYield         Float?
  currentStage        ProductionStage      @default(QUEUED)
  stageUpdatedAt      DateTime?
  operatorId          String?
  remarks             String?
  materialCost        Float?
  laborCost           Float?               @default(0)
  overheadCost        Float?               @default(0)
  totalCost           Float?
  warehouseId         String?
  batches             ProductBatch?
  customer            Customer?            @relation(fields: [customerId], references: [id])
  franchise           Franchise            @relation(fields: [franchiseId], references: [id])
  operator            Employee?            @relation(fields: [operatorId], references: [id])
  recipe              Recipe               @relation(fields: [recipeId], references: [id])
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id])
  items               ProductionItem[]
  stageLogs           ProductionStageLog[]

  @@index([franchiseId, status, producedAt])
}

model ProductionStageLog {
  id           String          @id @default(uuid())
  productionId String
  stage        ProductionStage
  enteredAt    DateTime        @default(now())
  production   Production      @relation(fields: [productionId], references: [id])
}

model ProductBatch {
  id               String             @id @default(uuid())
  productId        String?
  productionId     String?            @unique
  quantity         Float
  expiryDate       DateTime?
  batchCode        String?
  createdAt        DateTime           @default(now())
  franchiseId      String?
  mfgDate          DateTime?          @default(now())
  qcStatus         String?            @default("PENDING")
  moistureCheck    Float?
  colorCheck       String?
  textureCheck     String?
  rejectionQty     Float?             @default(0)
  approvedQty      Float?             @default(0)
  qcRemarks        String?
  packagingStatus  PackagingStatus?   @default(PENDING)
  packagedQty      Float?             @default(0)
  cartonedQty      Float?             @default(0)
  unitCost         Float?
  totalCost        Float?
  recall           BatchRecall?
  cartons          Carton[]
  inventoryBatches InventoryBatch[]
  franchise        Franchise?         @relation(fields: [franchiseId], references: [id])
  product          Product?           @relation(fields: [productId], references: [id])
  production       Production?        @relation(fields: [productionId], references: [id])
  packagings       ProductPackaging[]

  @@index([franchiseId, expiryDate])
}

model BatchRecall {
  id                 String                      @id @default(uuid())
  productBatchId     String                      @unique
  status             RecallStatus                @default(IN_PROGRESS)
  step               RecallStep                  @default(INITIATED)
  reason             String
  reasonNotes        String?
  distributedQty     Float                       @default(0)
  returnedQty        Float                       @default(0)
  affectedLocations  Json?
  reportData         Json?
  initiatedBy        String?
  initiatedAt        DateTime                    @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  updatedAt          DateTime                    @updatedAt
  productBatch       ProductBatch                @relation(fields: [productBatchId], references: [id])
  events             BatchRecallEvent[]
  returnItems        ReturnItem[]
  challanReturnItems DeliveryChallanReturnItem[]
}

model BatchRecallEvent {
  id          String      @id @default(uuid())
  recallId    String
  event       String
  status      String
  actor       String?
  affectedQty Float?
  details     Json?
  createdAt   DateTime    @default(now())
  recall      BatchRecall @relation(fields: [recallId], references: [id])
}

model Carton {
  id              String       @id @default(uuid())
  cartonCode      String       @unique
  batchId         String
  cartonSize      String
  unitsPerCarton  Int
  cartonCount     Int
  totalUnits      Int
  weightPerCarton Float?
  franchiseId     String?
  createdBy       String?
  createdAt       DateTime     @default(now())
  batch           ProductBatch @relation(fields: [batchId], references: [id])
  franchise       Franchise?   @relation(fields: [franchiseId], references: [id])
}

model ProductPackaging {
  id              String             @id @default(uuid())
  batchId         String
  packetSize      String
  quantityPackets Int
  totalWeight     Float
  barcode         String             @unique
  printedLabels   Boolean            @default(false)
  status          PackagingRunStatus @default(CONFIRMED)
  stickersPrinted Int?
  physicalChecked Boolean?
  goodQty         Int?
  damagedQty      Int?
  spoiledQty      Int?
  confirmedAt     DateTime?
  createdAt       DateTime           @default(now())
  // FIFO consumption snapshot of the bulk InventoryBatch lot(s) actually
  // drawn from at startPackaging() time — same shape/purpose as
  // ProductionItem.batchBreakdown for raw materials: [{ batchId,
  // productBatchId, billNumber, qty, unitCost, totalCost }]. This is the
  // authoritative source for confirmPackaging()'s allocatedBulkCost, since
  // the bulk pool can be shared across multiple ProductBatches at different
  // costs and FIFO may not select the batch open on screen.
  bulkBreakdown   Json?
  batch           ProductBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  wasteEntries    WasteEntry[]
}

model FranchiseOrder {
  id                   String                     @id @default(uuid())
  orderNumber          String                     @unique
  franchiseId          String
  status               FranchiseOrderStatus       @default(PENDING)
